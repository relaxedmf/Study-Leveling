/* ---- Storage Engine ---- */
const Storage = (function(){
  let db = null, useFallback = false;
  function openDB(){
    return new Promise((resolve) => {
      if(!('indexedDB' in window)){ useFallback = true; resolve(null); return; }
      try{
        const req = indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = (e) => {
          const _db = e.target.result;
          if(!_db.objectStoreNames.contains(STORE)) _db.createObjectStore(STORE);
        };
        req.onsuccess = (e) => { db = e.target.result; resolve(db); };
        req.onerror = () => { useFallback = true; resolve(null); };
      }catch(err){ useFallback = true; resolve(null); }
    });
  }
  function get(key){
    return new Promise((resolve) => {
      if(useFallback || !db){
        try{ const raw = localStorage.getItem('study_'+key); resolve(raw ? JSON.parse(raw) : null); }
        catch(e){ resolve(null); }
        return;
      }
      try{
        const tx = db.transaction(STORE, 'readonly');
        const req = tx.objectStore(STORE).get(key);
        req.onsuccess = () => resolve(req.result !== undefined ? req.result : null);
        req.onerror = () => resolve(null);
      }catch(e){ resolve(null); }
    });
  }
  function set(key, value){
    return new Promise((resolve) => {
      if(useFallback || !db){
        try{ localStorage.setItem('study_'+key, JSON.stringify(value)); resolve(true); }
        catch(e){ resolve(false); }
        return;
      }
      try{
        const tx = db.transaction(STORE, 'readwrite');
        tx.objectStore(STORE).put(value, key);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => resolve(false);
      }catch(e){ resolve(false); }
    });
  }
  return { init: openDB, get, set };
})();

