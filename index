/* ---- Timer System ---- */
const TIMER_PRESETS = { '25/5': [25,5], '50/10': [50,10], '90/20': [90,20] };
const Timer = (function(){
  let intervalHandle = null;

  function currentPhaseTotalSec(){
    const t = STATE.timer;
    return (t.phase === 'focus' ? t.focusMin : t.breakMin) * 60;
  }

  function applyMode(mode){
    const t = STATE.timer;
    t.mode = mode;
    const preset = TIMER_PRESETS[mode];
    if(preset){ t.focusMin = preset[0]; t.breakMin = preset[1]; }
    if(!t.running) t.remainingSec = currentPhaseTotalSec();
    persist(); UI.renderTimer();
  }

  function setCustom(focusMin, breakMin){
    const t = STATE.timer;
    t.mode = 'custom'; t.focusMin = focusMin; t.breakMin = breakMin;
    if(!t.running) t.remainingSec = currentPhaseTotalSec();
    persist(); UI.renderTimer();
  }

  function start(){
    const t = STATE.timer; if(t.running) return;
    if(!t.remainingSec || t.remainingSec <= 0) t.remainingSec = currentPhaseTotalSec();
    t.running = true; t.endAt = Date.now() + t.remainingSec*1000; persist();
    runLoop(); UI.renderTimer();
  }
  function pause(){
    const t = STATE.timer;
    if(t.running){ t.remainingSec = Math.max(0, Math.round((t.endAt - Date.now())/1000)); t.running = false; }
    if(intervalHandle){ clearInterval(intervalHandle); intervalHandle = null; }
    persist(); UI.renderTimer();
  }
  function reset(){
    pause(); const t = STATE.timer; t.phase = 'focus'; t.remainingSec = t.focusMin*60; persist(); UI.renderTimer();
  }
  function runLoop(){
    if(intervalHandle) clearInterval(intervalHandle);
    intervalHandle = setInterval(() => {
      const t = STATE.timer; if(!t.running) return;
      const remaining = Math.round((t.endAt - Date.now())/1000);
      if(remaining <= 0){
        if(t.phase === 'focus'){
          const sec = t.focusMin*60;
          STATE.sessions.push({ start: Date.now()-sec*1000, end: Date.now(), durationSec: sec, mode: t.mode });
          STATE.today.studySeconds += sec; Activity.log(); Activity.refreshStreak();
          t.phase = 'break'; t.remainingSec = t.breakMin*60;
          Notify.toast('info', 'Focus Session Complete', `Logged ${Math.round(sec/60)} min study time.`);
        } else {
          t.phase = 'focus'; t.remainingSec = t.focusMin*60;
          Notify.toast('info', 'Break Over', 'Back to focus!');
        }
        t.endAt = Date.now() + t.remainingSec*1000; Sound.play('quest');
        Quests.refresh(); Achievements.check(); persist(); UI.renderTimer(); UI.renderDashboard();
      } else {
        t.remainingSec = remaining; UI.updateTimerDisplay();
      }
    }, 500);
  }
  // Resumes a countdown that was still running when the page was last closed/reloaded.
  function resumeIfNeeded(){
    const t = STATE.timer; if(!t || !t.running) return;
    const remaining = Math.round(((t.endAt||Date.now()) - Date.now())/1000);
    if(remaining <= 0){ t.running = false; t.remainingSec = 0; persist(); return; }
    t.remainingSec = remaining;
    runLoop();
  }
  return { start, pause, stop: pause, reset, applyMode, setCustom, resumeIfNeeded };
})();

/* ---- Google Drive Sync ---- */
const DriveSync = (function(){
  const SCOPE = 'https://www.googleapis.com/auth/drive.appdata';
  const FILE_NAME = 'study-ascension-sync.json';
  let tokenClient = null;
  let accessToken = null;
  let tokenExpiresAt = 0;
  let autoSyncTimer = null;

  function cfg(){
    STATE.settings.driveSync = STATE.settings.driveSync || { clientId:'', fileId:null, lastSyncedAt:null, autoSync:false };
    return STATE.settings.driveSync;
  }

  function setStatus(text, kind){
    const el = document.getElementById('drive-status');
    const txt = document.getElementById('drive-status-text');
    if(txt) txt.textContent = text;
    if(el) el.className = 'drive-status' + (kind ? ' '+kind : '');
  }

  function ensureGis(){
    return new Promise((resolve, reject) => {
      if(window.google && window.google.accounts && window.google.accounts.oauth2){ resolve(); return; }
      let tries = 0;
      const iv = setInterval(() => {
        tries++;
        if(window.google && window.google.accounts && window.google.accounts.oauth2){ clearInterval(iv); resolve(); }
        else if(tries > 100){ clearInterval(iv); reject(new Error('Google sign-in script failed to load.')); }
      }, 100);
    });
  }

  function initTokenClient(){
    const clientId = (cfg().clientId||'').trim();
    if(!clientId) throw new Error('Enter a Google OAuth Client ID first.');
    tokenClient = google.accounts.oauth2.initTokenClient({ client_id: clientId, scope: SCOPE, callback: () => {} });
  }

  function requestToken(interactive){
    return new Promise((resolve, reject) => {
      try{ if(!tokenClient) initTokenClient(); }catch(err){ reject(err); return; }
      tokenClient.callback = (resp) => {
        if(resp && resp.error){ reject(new Error(resp.error)); return; }
        accessToken = resp.access_token;
        tokenExpiresAt = Date.now() + ((resp.expires_in||3300) * 1000);
        resolve(accessToken);
      };
      tokenClient.requestAccessToken({ prompt: interactive ? 'consent' : '' });
    });
  }

  async function getToken(){
    if(accessToken && Date.now() < tokenExpiresAt - 30000) return accessToken;
    return requestToken(!accessToken);
  }

  async function findFileId(token){
    const url = 'https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q=' + encodeURIComponent(`name='${FILE_NAME}'`) + '&fields=files(id,name)';
    const res = await fetch(url, { headers: { Authorization: 'Bearer ' + token } });
    if(!res.ok) throw new Error('Drive lookup failed (' + res.status + ')');
    const data = await res.json();
    if(data.files && data.files.length) return data.files[0].id;
    return null;
  }

  async function createFile(token, content){
    const metadata = { name: FILE_NAME, parents: ['appDataFolder'] };
    const boundary = 'studysync' + Date.now();
    const body =
      `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify(metadata)}\r\n` +
      `--${boundary}\r\nContent-Type: application/json\r\n\r\n${content}\r\n--${boundary}--`;
    const res = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id', {
      method: 'POST',
      headers: { Authorization: 'Bearer ' + token, 'Content-Type': `multipart/related; boundary=${boundary}` },
      body
    });
    if(!res.ok) throw new Error('Drive upload failed (' + res.status + ')');
    const data = await res.json();
    return data.id;
  }

  async function updateFile(token, fileId, content){
    const res = await fetch(`https://www.googleapis.com/upload/drive/v3/files/${fileId}?uploadType=media`, {
      method: 'PATCH',
      headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: content
    });
    if(!res.ok) throw new Error('Drive update failed (' + res.status + ')');
  }

  async function downloadFile(token, fileId){
    const res = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, { headers: { Authorization: 'Bearer ' + token } });
    if(!res.ok) throw new Error('Drive download failed (' + res.status + ')');
    return res.text();
  }

  async function connect(){
    try{
      setStatus('Connecting…');
      await ensureGis();
      const token = await requestToken(true);
      setStatus('Connected · looking up backup…', 'connected');
      const fileId = await findFileId(token);
      cfg().fileId = fileId;
      persist();
      setStatus(fileId ? 'Connected · backup found on Drive' : 'Connected · no backup yet', 'connected');
      Notify.toast('info', 'Google Drive Connected', 'You can now push or pull your progress.');
    }catch(err){
      setStatus('Connection failed: ' + (err.message||'unknown error'), 'error');
      Notify.toast('info', 'Google Drive Error', err.message || 'Could not connect.');
    }
  }

  async function push(silent){
    try{
      const token = await getToken();
      const content = JSON.stringify({ exportedAt: new Date().toISOString(), app:'Study Ascension System', state: STATE });
      let fileId = cfg().fileId || await findFileId(token);
      if(fileId){ await updateFile(token, fileId, content); }
      else { fileId = await createFile(token, content); }
      cfg().fileId = fileId;
      cfg().lastSyncedAt = new Date().toISOString();
      persist();
      setStatus('Synced · ' + new Date().toLocaleTimeString(), 'connected');
      if(!silent) Notify.toast('info', 'Synced to Drive', 'Your progress has been backed up.');
    }catch(err){
      setStatus('Sync failed: ' + (err.message||'unknown error'), 'error');
      if(!silent) Notify.toast('info', 'Sync Failed', err.message || 'Could not push to Drive.');
    }
  }

  async function pull(){
    try{
      const token = await getToken();
      let fileId = cfg().fileId || await findFileId(token);
      if(!fileId){ Notify.toast('info', 'No Backup Found', 'Nothing has been synced to Drive yet.'); return; }
      const raw = await downloadFile(token, fileId);
      const data = JSON.parse(raw);
      if(!data.state) throw new Error('Backup file is not valid.');
      const keptDrive = Object.assign({}, cfg(), { fileId });
      STATE = Object.assign(defaultState(), data.state);
      STATE.settings = Object.assign(
        { theme:'solo-blue', sound:true, animations:true, xpRates: Object.assign({}, DEFAULT_XP_RATES), driveSync: { clientId:'', fileId:null, lastSyncedAt:null, autoSync:false } },
        data.state.settings||{}
      );
      STATE.settings.driveSync = keptDrive;
      persist();
      document.documentElement.setAttribute('data-theme', STATE.settings.theme);
      RenderAll();
      setStatus('Restored from Drive', 'connected');
      Notify.toast('info', 'Restored from Drive', 'Your progress has been synced from Google Drive.');
    }catch(err){
      setStatus('Restore failed: ' + (err.message||'unknown error'), 'error');
      Notify.toast('info', 'Restore Failed', err.message || 'Could not pull from Drive.');
    }
  }

  function scheduleAutoSync(){
    if(!STATE || !cfg().autoSync || !accessToken) return;
    if(autoSyncTimer) clearTimeout(autoSyncTimer);
    autoSyncTimer = setTimeout(() => push(true), 4000);
  }

  function initUI(){
    const clientInput = document.getElementById('drive-client-id');
    if(clientInput){
      clientInput.value = cfg().clientId || '';
      clientInput.addEventListener('change', () => {
        cfg().clientId = clientInput.value.trim();
        tokenClient = null; accessToken = null;
        persist();
      });
    }
    const autoToggle = document.getElementById('toggle-drive-autosync');
    if(autoToggle){
      autoToggle.classList.toggle('on', !!cfg().autoSync);
      autoToggle.addEventListener('click', () => {
        cfg().autoSync = !cfg().autoSync;
        autoToggle.classList.toggle('on', cfg().autoSync);
        persist();
      });
    }
    if(cfg().lastSyncedAt) setStatus('Last synced ' + new Date(cfg().lastSyncedAt).toLocaleString());
    const btnConnect = document.getElementById('btn-drive-connect');
    if(btnConnect) btnConnect.addEventListener('click', () => connect());
    const btnPush = document.getElementById('btn-drive-push');
    if(btnPush) btnPush.addEventListener('click', () => push(false));
    const btnPull = document.getElementById('btn-drive-pull');
    if(btnPull) btnPull.addEventListener('click', () => {
      if(confirm('This will overwrite your local progress with the backup stored in Drive. Continue?')) pull();
    });
  }

  return { initUI, push, pull, connect, scheduleAutoSync };
})();

