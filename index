    document.querySelectorAll('.timer-modes .filter-chip').forEach(chip => {
      chip.classList.toggle('active', chip.dataset.mode === t.mode);
    });
    const customInputs = document.getElementById('custom-timer-inputs');
    if(customInputs) customInputs.classList.toggle('hidden', t.mode !== 'custom');
    const cfEl = document.getElementById('custom-focus'); if(cfEl && document.activeElement !== cfEl) cfEl.value = t.focusMin;
    const cbEl = document.getElementById('custom-break'); if(cbEl && document.activeElement !== cbEl) cbEl.value = t.breakMin;

    const btnStart = document.getElementById('btn-timer-start');
    const btnPause = document.getElementById('btn-timer-pause');
    if(btnStart) btnStart.disabled = !!t.running;
    if(btnPause) btnPause.disabled = !t.running;

    UI.updateTimerDisplay();
  },

  updateTimerDisplay(){
    const t = STATE.timer;
    document.getElementById('timer-display').textContent = fmtSecs(t.remainingSec);
    const totalSec = (t.phase === 'focus' ? t.focusMin : t.breakMin) * 60;
    const ring = document.getElementById('timer-ring');
    if(ring){
      const circumference = 2 * Math.PI * 114;
      const frac = totalSec > 0 ? clamp(t.remainingSec / totalSec, 0, 1) : 0;
      ring.setAttribute('stroke-dasharray', circumference.toFixed(1));
      ring.setAttribute('stroke-dashoffset', (circumference * (1 - frac)).toFixed(1));
    }
  },

