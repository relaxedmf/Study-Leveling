  applyTheme(theme){
    document.documentElement.setAttribute('data-theme', theme);
    STATE.settings.theme = theme;
    persist();
    document.querySelectorAll('.theme-swatch').forEach(el => el.classList.toggle('active', el.dataset.theme === theme));
  }
};

/* ---- Data Operations (Backup, Restore, Reset) ---- */
const DataOps = {
  exportBackup(){
    const payload = { exportedAt: new Date().toISOString(), app:'Study Ascension System', state: STATE };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type:'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `study-ascension-backup-${todayStr()}.json`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    Notify.toast('info', 'Backup Exported', 'Your progress has been downloaded as JSON.');
  },
  importBackup(file){
    const reader = new FileReader();
    reader.onload = (e) => {
      try{
        const data = JSON.parse(e.target.result);
        if(!data.state) throw new Error('Invalid backup file structure.');
        STATE = Object.assign(defaultState(), data.state);
        STATE.settings = Object.assign(
          { theme:'solo-blue', sound:true, animations:true, xpRates: Object.assign({}, DEFAULT_XP_RATES), driveSync: { clientId:'', fileId:null, lastSyncedAt:null, autoSync:false } },
          data.state.settings||{}
        );
        STATE.settings.driveSync = Object.assign({ clientId:'', fileId:null, lastSyncedAt:null, autoSync:false }, (data.state.settings||{}).driveSync||{});
        persist();
        document.documentElement.setAttribute('data-theme', STATE.settings.theme);
        RenderAll();
        Notify.toast('info', 'Backup Restored', 'Your progress has been imported successfully.');
      }catch(err){
        Notify.toast('info', 'Import Failed', err.message || 'Could not read backup file.');
      }
    };
    reader.readAsText(file);
  },
  resetAll(){
    STATE = defaultState();
    STATE.settings.theme = document.documentElement.getAttribute('data-theme') || 'solo-blue';
    persist(); RenderAll();
    Notify.toast('info', 'Progress Reset', 'All XP, question banks, mastery data, quests, and achievements have been cleared.');
  }
};

/* ---- Resource Operations ---- */
const ResourceOps = {
  addResource(material, link){
    if(!material || !material.trim()){ Notify.toast('info', 'Title Required', 'Please enter a name for the resource.'); return false; }
    if(!link || !link.trim()){ Notify.toast('info', 'Link Required', 'Please enter a URL link.'); return false; }
    STATE.customResources = STATE.customResources || [];
    STATE.customResources.push({ id: uid('res'), material: material.trim(), link: link.trim() });
    persist(); UI.renderResources();
    Notify.toast('info', 'Resource Added', `Added "${material.trim()}".`);
    return true;
  },
  deleteResource(id){
    if(!confirm('Are you sure you want to delete this resource link?')) return;
    STATE.customResources = (STATE.customResources || []).filter(r => r.id !== id);
    persist();
    UI.renderResources();
    Notify.toast('info', 'Resource Deleted', 'Resource link has been removed.');
  },
  editResource(id){
    const current = (STATE.customResources || []).find(r => r.id === id);
    if(!current) return;
    const newMaterial = prompt('Edit Resource Title:', current.material);
    if(newMaterial === null) return;
    const newLink = prompt('Edit URL Link:', current.link);
    if(newLink === null) return;
    if(!newMaterial.trim() || !newLink.trim()){ Notify.toast('info', 'Invalid Input', 'Title and Link cannot be empty.'); return; }
    current.material = newMaterial.trim(); current.link = newLink.trim();
    persist();
    UI.renderResources();
    Notify.toast('info', 'Resource Updated', `Updated "${current.material}".`);
  }
};

function RenderAll(){
  UI.updateTopbar(); UI.renderDashboard(); UI.renderQuests(); UI.renderAchievements(); UI.renderResources(); UI.renderQuestionBanks(); UI.renderSettings();
}

/* ---- Event Wiring ---- */
function wireEvents(){
  document.querySelectorAll('.nav-item').forEach(el => { el.addEventListener('click', () => { Sound.play('click'); UI.switchView(el.dataset.view); }); });
  document.getElementById('btn-sound').addEventListener('click', () => {
    STATE.settings.sound = !STATE.settings.sound;
    document.getElementById('btn-sound').textContent = STATE.settings.sound ? '\u{1F50A}' : '\u{1F507}';
    persist();
  });
  document.getElementById('btn-theme').addEventListener('click', () => {
    const idx = THEME_ORDER.indexOf(STATE.settings.theme);
    const next = THEME_ORDER[(idx+1)%THEME_ORDER.length];
    UI.applyTheme(next);
  });

  // --- Focus Timer ---
  const btnTimerStart = document.getElementById('btn-timer-start');
  if(btnTimerStart) btnTimerStart.addEventListener('click', () => { Sound.play('click'); Timer.start(); });
  const btnTimerPause = document.getElementById('btn-timer-pause');
  if(btnTimerPause) btnTimerPause.addEventListener('click', () => { Sound.play('click'); Timer.pause(); });
  const btnTimerReset = document.getElementById('btn-timer-reset');
  if(btnTimerReset) btnTimerReset.addEventListener('click', () => { Sound.play('click'); Timer.reset(); });

  document.querySelectorAll('.timer-modes .filter-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      Sound.play('click');
      const mode = chip.dataset.mode;
      if(mode === 'custom'){
        const f = parseInt(document.getElementById('custom-focus').value, 10);
        const b = parseInt(document.getElementById('custom-break').value, 10);
        Timer.setCustom((!isNaN(f)&&f>0)?f:25, (!isNaN(b)&&b>0)?b:5);
      } else {
        Timer.applyMode(mode);
      }
    });
  });

  function applyCustomTimerInputs(){
    const f = parseInt(document.getElementById('custom-focus').value, 10);
    const b = parseInt(document.getElementById('custom-break').value, 10);
    Timer.setCustom((!isNaN(f)&&f>0)?f:25, (!isNaN(b)&&b>0)?b:5);
  }
  const customFocusInput = document.getElementById('custom-focus');
  if(customFocusInput) customFocusInput.addEventListener('change', applyCustomTimerInputs);
  const customBreakInput = document.getElementById('custom-break');
  if(customBreakInput) customBreakInput.addEventListener('change', applyCustomTimerInputs);

  // Global search — jumps to Question Banks and filters the live database preview
  const gSearch = document.getElementById('global-search');
  if(gSearch){
    gSearch.addEventListener('input', debounce((e) => {
      UI.filters.search = e.target.value;
      if(!document.getElementById('view-question-banks').classList.contains('active')){
        UI.switchView('question-banks');
      }
      const qbSearchBox = document.getElementById('qb-preview-search');
      if(qbSearchBox) qbSearchBox.value = e.target.value;
      UI.renderQuestionBankPreview();
    }, 200));
  }

  // --- Question Bank Manager Dropzone & Drag-and-Drop ---
  const qbDropzone = document.getElementById('qb-dropzone');
  const qbFileInput = document.getElementById('qb-file-input');
  if(qbDropzone && qbFileInput){
    qbDropzone.addEventListener('click', () => qbFileInput.click());
    qbFileInput.addEventListener('change', (e) => {
      if(e.target.files && e.target.files.length) QuestionBankManager.addBankFiles(e.target.files);
      e.target.value = '';
    });
    qbDropzone.addEventListener('dragover', (e) => { e.preventDefault(); qbDropzone.classList.add('drag-over'); });
    qbDropzone.addEventListener('dragleave', () => qbDropzone.classList.remove('drag-over'));
    qbDropzone.addEventListener('drop', (e) => {
      e.preventDefault(); qbDropzone.classList.remove('drag-over');
      if(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) QuestionBankManager.addBankFiles(e.dataTransfer.files);
    });
  }

  const qbListEl = document.getElementById('qb-bank-list');
  if(qbListEl){
    qbListEl.addEventListener('click', (e) => {
      const startBankQuiz = e.target.closest('[data-start-bank-quiz]');
      if(startBankQuiz){
        const bankId = startBankQuiz.dataset.startBankQuiz;
        const targetBank = QuestionBankManager.getAllBanks().find(b => b.id === bankId);
        QuizEngine.createQuiz({ title: targetBank ? targetBank.fileName : 'Question Bank', scopeType: 'bank', scopeValue: bankId, count: 'all' });
        UI.switchView('quiz-engine');
        Notify.toast('info', 'Quiz Started', `Started quiz for "${targetBank ? targetBank.fileName : 'Question Bank'}".`);
        return;
      }
      const toggle = e.target.closest('[data-qb-toggle]');
      if(toggle){ QuestionBankManager.toggleBank(toggle.dataset.qbToggle); return; }
      const delBtn = e.target.closest('[data-qb-delete]');
      if(delBtn){ QuestionBankManager.deleteBank(delBtn.dataset.qbDelete); return; }
    });
    qbListEl.addEventListener('change', (e) => {
      const renameInput = e.target.closest('[data-rename-bank]');
      if(renameInput){
        QuestionBankManager.renameBank(renameInput.dataset.renameBank, renameInput.value);
        return;
      }
      const topicSelect = e.target.closest('[data-bank-topic-select]');
      if(topicSelect){
        QuestionBankManager.setBankTopic(topicSelect.dataset.bankTopicSelect, topicSelect.value);
        Notify.toast('success', 'Topic Assigned', 'Question bank topic updated.');
        return;
      }
    });
