    questionBanks: [], topics: [], activeQuiz: null, quizHistory: [], questionStats: {}, questionMastery: {}, customResources: [],
    questsCompletedTotal: 0, perfectQuizTotal: 0, sessions: [],
    timer: { mode:'25/5', focusMin:25, breakMin:5, phase:'focus', running:false, startedAt:null, remainingSec:25*60 },
    settings: {
      theme:'solo-blue', sound:true, animations:true, xpRates: Object.assign({}, DEFAULT_XP_RATES),
      driveSync: { clientId:'', fileId:null, lastSyncedAt:null, autoSync:false }
    }
  };
}

function getQuestionStats(qId){
  STATE.questionStats = STATE.questionStats || {};
  if(!STATE.questionStats[qId]){
    STATE.questionStats[qId] = { timesAnswered: 0, timesCorrect: 0, timesWrong: 0, currentStreak: 0, important: false };
  }
  return STATE.questionStats[qId];
}

const persist = debounce(function(){
  Storage.set('state', STATE);
  if(typeof DriveSync !== 'undefined') DriveSync.scheduleAutoSync();
}, 350);

// persist() is debounced (350ms) so rapid edits don't spam storage writes.
// But if the tab is closed/switched away right after a change (e.g. assigning
// a topic), that pending write can be lost before the debounce fires. Force
// an immediate, non-debounced save whenever the page is about to go away.
function flushPersist(){
  if(STATE) Storage.set('state', STATE);
}
document.addEventListener('visibilitychange', () => {
  if(document.visibilityState === 'hidden') flushPersist();
});
window.addEventListener('pagehide', flushPersist);
window.addEventListener('beforeunload', flushPersist);

function rolloverToday(){
  const t = todayStr();
  if(STATE.today.date !== t) STATE.today = { date:t, reviewCount:0, perfectQuizzes:0, masteredToday:0, studySeconds:0, questionsAnswered:0 };
  if(STATE.quests.date !== t) STATE.quests = { date:t, list: Quests.generateForDate(t) };
}


/* ---- Level & XP Systems ---- */
const HunterSystem = {
  xpForLevel(lvl){ return Math.floor(120 * Math.pow(1.42, lvl - 1)); },
  getLevelInfo(totalXp){
    let lvl = 1, accumulated = 0;
    while(true){
      const req = HunterSystem.xpForLevel(lvl);
      if(totalXp < accumulated + req){
        return { level: lvl, currentXP: totalXp - accumulated, requiredXP: req, progressPct: Math.min(100, Math.round(((totalXp - accumulated)/req)*100)) };
      }
      accumulated += req; lvl++; if(lvl > 200) break;
    }
    return { level: 200, currentXP: 0, requiredXP: 999999, progressPct: 100 };
  },
  getRankAndTitle(lvl, prestigeTier){
    const pPrefix = prestigeTier > 0 ? `P${prestigeTier}-` : '';
    let key = 'E', name = 'E-Rank Hunter', title = 'Awakened Hunter';
    if(lvl >= 100 || prestigeTier > 0){ key = 'M'; name = 'Shadow Monarch'; title = 'Monarch of Ascension'; }
    else if(lvl >= 85){ key = 'N'; name = 'National-Level Hunter'; title = 'Grandmaster Hunter'; }
    else if(lvl >= 65){ key = 'S'; name = 'S-Rank Hunter'; title = 'Apex Master'; }
    else if(lvl >= 45){ key = 'A'; name = 'A-Rank Hunter'; title = 'Senior Architect'; }
    else if(lvl >= 30){ key = 'B'; name = 'B-Rank Hunter'; title = 'Challenger'; }
    else if(lvl >= 15){ key = 'C'; name = 'C-Rank Hunter'; title = 'Journeyman'; }
    else if(lvl >= 6){  key = 'D'; name = 'D-Rank Hunter'; title = 'Apprentice Hunter'; }
    return { key, name: `${pPrefix}${name}`, title: `${title}${prestigeTier > 0 ? ` [P${prestigeTier}]` : ''}` };
  },
  prestigeAscend(){
    const info = HunterSystem.getLevelInfo(STATE.xp);
    if(info.level < 100){
      Notify.toast('info', 'Not Yet Eligible', 'Reach Level 100 to Prestige Ascend.');
      return;
    }
    STATE.prestigeTier = (STATE.prestigeTier || 0) + 1;
    STATE.xp = 0;
    STATE.skillPoints = (STATE.skillPoints || 0) + 10;
    persist();
    FX.rankUp({ key: 'M', name: `PRESTIGE ${STATE.prestigeTier}!` });
    Sound.play('levelup');
    Notify.toast('rank', 'Prestige Ascension!', `You are now Prestige Tier ${STATE.prestigeTier} with a permanent +${STATE.prestigeTier * 25}% XP boost.`);
    UI.updateTopbar(); UI.renderDashboard(); UI.renderSettings();
  }
};

const XP = {
  rankFor(xp){ return HunterSystem.getRankAndTitle(HunterSystem.getLevelInfo(xp).level, STATE ? STATE.prestigeTier : 0); },
  nextRank(xp){ const info = HunterSystem.getLevelInfo(xp); return { min: info.requiredXP, name: `Level ${info.level + 1}` }; },
  add(amount, source, opts){
    opts = opts || {};
    const prestigeMult = 1 + ((STATE ? (STATE.prestigeTier || 0) : 0) * 0.25);
    const finalAmount = Math.round(amount * prestigeMult);
    const prevInfo = HunterSystem.getLevelInfo(STATE.xp);
    STATE.xp += finalAmount;
    const d = todayStr(); STATE.dailyXP[d] = (STATE.dailyXP[d]||0) + finalAmount;
    const newInfo = HunterSystem.getLevelInfo(STATE.xp);

    if(!opts.silent) Notify.floatXP(finalAmount, opts.x, opts.y);
    if(newInfo.level > prevInfo.level){
      STATE.skillPoints = (STATE.skillPoints || 0) + (newInfo.level - prevInfo.level);
      const rankInfo = HunterSystem.getRankAndTitle(newInfo.level, STATE.prestigeTier);
      FX.rankUp({ key: rankInfo.key, name: `LEVEL UP! (LV. ${newInfo.level})` });
      Sound.play('levelup');
      Notify.toast('rank', `Level Up! Level ${newInfo.level}`, `${rankInfo.title}`);
    }
    UI.updateTopbar();
  }
};

/* ---- Activity & Streaks ---- */
const Activity = {
  log(){ const d = todayStr(); STATE.activityLog[d] = (STATE.activityLog[d]||0) + 1; },
  computeStreak(){
    const days = Object.keys(STATE.activityLog).filter(d => STATE.activityLog[d] > 0).sort();
    if(!days.length) return { current:0, longest:0 };
    const daySet = new Set(days);
    let longest = 0, run = 0, prev = null;
    for(const d of days){ run = (prev && isNextDay(prev, d)) ? run + 1 : 1; longest = Math.max(longest, run); prev = d; }
    let cur = 0, cursor = new Date();
    if(!daySet.has(fmtDate(cursor))) cursor.setDate(cursor.getDate()-1);
    while(daySet.has(fmtDate(cursor))){ cur++; cursor.setDate(cursor.getDate()-1); }
    return { current: cur, longest };
  },
  refreshStreak(){
    const prev = STATE.streak.current || 0;
    const s = Activity.computeStreak();
    STATE.streak.current = s.current;
    STATE.streak.longest = Math.max(STATE.streak.longest||0, s.longest);
    if(s.current > prev && s.current > 0){
      const today = todayStr();
      if(STATE.streak.lastMilestoneToastDate !== today){
        STATE.streak.lastMilestoneToastDate = today;
        Notify.toast('info', 'Streak Extended', `\u{1F525} ${s.current} day streak! Keep it going.`);
      }
    }
  },
  heatmapData(days){
    const out = []; let cursor = new Date();
    for(let i=0;i<days;i++){ const d = fmtDate(cursor); out.unshift({ date: d, count: STATE.activityLog[d] || 0 }); cursor.setDate(cursor.getDate()-1); }
    return out;
  },
  levelForCount(c){ if(c <= 0) return 0; if(c <= 2) return 1; if(c <= 5) return 2; if(c <= 10) return 3; return 4; }
};

/* ---- Achievements Engine ---- */
const Achievements = {
  buildContext(){
    const dbData = QuestionBankManager.getMergedDatabase();
    const totalQuestions = dbData.mergedQuestions.length;
    let masteredCount = 0;
    dbData.mergedQuestions.forEach(q => { if(MasterySystem.getMastery(q.id).masteryLevel === 'Mastered') masteredCount++; });
    const banksCount = dbData.totalBanksCount;
    const fullyMasteredBanks = QuestionBankManager.getAllBanks().filter(b => (b.questions||[]).length && QuestionBankManager.getBankStats(b).progressPct >= 100).length;
    const importantCount = Object.values(STATE.questionStats||{}).filter(s => s.important).length;
    const totalStudySeconds = (STATE.sessions||[]).reduce((s,ses) => s + (ses.durationSec||0), 0);
    const maxSessionMin = (STATE.sessions||[]).reduce((m,ses) => Math.max(m, (ses.durationSec||0)/60), 0);
    let nightOwl = false, earlyBird = false;
    (STATE.quizHistory||[]).forEach(qz => {
      if(!qz.completedAt) return;
      const h = new Date(qz.completedAt).getHours();
      if(h >= 22) nightOwl = true; if(h < 6) earlyBird = true;
    });
    const questionsAnswered = Object.values(STATE.dailyQuestionsLog||{}).reduce((s,v) => s+v, 0);
    return {
      masteredCount, totalQuestions, overallPct: totalQuestions ? (masteredCount/totalQuestions*100) : 0,
      banksCount, fullyMasteredBanks, importantCount,
      totalStudyHours: totalStudySeconds/3600, maxSessionMin, nightOwl, earlyBird,
      streak: STATE.streak.current, questsCompleted: STATE.questsCompletedTotal,
      questionsAnswered, perfectQuizTotal: STATE.perfectQuizTotal || 0,
      rankKey: HunterSystem.getRankAndTitle(HunterSystem.getLevelInfo(STATE.xp).level, STATE.prestigeTier).key
    };
  },
  check(){
    const ctx = Achievements.buildContext();
    const newlyUnlocked = [];
    ACHIEVEMENTS.forEach(a => {
      if(STATE.achievements[a.id]) return;
      try{ if(a.cond(ctx)){ STATE.achievements[a.id] = new Date().toISOString(); newlyUnlocked.push(a); } }catch(e){}
    });
    if(newlyUnlocked.length) newlyUnlocked.forEach((a,i) => setTimeout(() => Notify.achievementPopup(a), i*1600));
    return newlyUnlocked;
  }
};

/* ---- Quests Engine ---- */
const Quests = {
  generateForDate(dateStr){
    const seed = hashStr(dateStr);
    const picks = seededPick(QUEST_TEMPLATES, 5, seed);
    return picks.map(q => ({ id: q.id, type: q.type, target: q.target, xp: q.baseXP, title: q.title, desc: q.desc, progress: 0, done: false, claimed: false }));
  },
  progressValue(q){
    const t = STATE.today;
    switch(q.type){
      case 'study_minutes': return Math.floor(t.studySeconds/60);
      case 'questions': return t.questionsAnswered || 0;
      case 'review_important': return t.reviewCount || 0;
      case 'mastered': return t.masteredToday || 0;
      case 'perfect_quiz': return t.perfectQuizzes || 0;
      case 'streak': return (STATE.streak && STATE.streak.current > 0) ? 1 : 0;
      default: return 0;
    }
  },
  refresh(){
    rolloverToday();
    STATE.quests.list.forEach(q => {
      q.progress = Quests.progressValue(q);
      if(!q.done && q.progress >= q.target){
        q.done = true;
        if(!q.claimed){
          q.claimed = true; STATE.questsCompletedTotal++;
          XP.add(q.xp, 'quest', { silent:true });
          Notify.toast('quest', 'Quest Completed', `${q.title} — +${q.xp} XP`);
          Sound.play('quest');
        }
      }
    });
  }
};

/* ---- Synthesized Sound Engine ---- */
const Sound = (function(){
  let ctx = null;
  function ensureCtx(){ if(!ctx){ try{ ctx = new (window.AudioContext || window.webkitAudioContext)(); }catch(e){} } return ctx; }
  function tone(freq, dur, type, delay, gainPeak){
    const ac = ensureCtx(); if(!ac) return;
    const osc = ac.createOscillator(), gain = ac.createGain();
    osc.type = type || 'sine'; osc.frequency.value = freq;
    const t0 = ac.currentTime + (delay||0);
    gain.gain.setValueAtTime(0, t0); gain.gain.linearRampToValueAtTime(gainPeak||0.12, t0+0.02); gain.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    osc.connect(gain).connect(ac.destination); osc.start(t0); osc.stop(t0+dur+0.02);
  }
  return {
    play(name){
      if(!STATE || !STATE.settings.sound) return;
      if(name==='click') tone(740, 0.06, 'triangle', 0, 0.08);
      else if(name==='check'){ tone(520,0.09,'sine',0,0.1); tone(780,0.12,'sine',0.05,0.09); }
      else if(name==='quest'){ tone(440,0.12,'sine',0,0.1); tone(660,0.12,'sine',0.1,0.1); tone(880,0.18,'sine',0.2,0.1); }
      else if(name==='levelup'){ tone(392,0.14,'sawtooth',0,0.08); tone(523,0.14,'sawtooth',0.1,0.08); tone(659,0.2,'sawtooth',0.2,0.08); tone(880,0.3,'sawtooth',0.32,0.1); }
    }
  };
})();

