<!DOCTYPE html>
<html lang="en" data-theme="solo-blue">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>STUDY LEVELING // Hunter Ascension System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Chakra+Petch:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<style>
/* ============================================================
   STUDY ASCENSION SYSTEM — Core Stylesheet
   ============================================================ */

* { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font-body); }

:root{
  --bg: #05060d;
  --bg-deep: #020308;
  --bg-elevated: #0b0f1e;
  --panel-bg: rgba(16, 21, 41, 0.62);
  --panel-bg-solid: #0e1226;
  --panel-border: rgba(41, 211, 255, 0.38);
  --panel-border-strong: rgba(41, 211, 255, 0.65);

  --accent-blue: #29d3ff;
  --accent-blue-2: #3b7dff;
  --accent-purple: #b06bff;
  --accent-purple-2: #7c3aed;
  --accent-cyan: #00f2fe;
  --accent-gradient: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%);

  --gold: #ffd166;
  --gold-dim: #a8843a;
  --danger: #ff4d6d;
  --danger-dim: #7a2334;
  --success: #34eab9;

  --text-hi: #edf1ff;
  --text-mid: #a3acd6;
  --text-dim: #656d94;

  --font-display: 'Orbitron', 'Chakra Petch', monospace;
  --font-mono: 'Chakra Petch', 'Orbitron', monospace;
  --font-body: 'Chakra Petch', 'Orbitron', monospace;

  --radius: 14px;
  --radius-sm: 8px;
  --shadow-glow: 0 0 24px rgba(41, 211, 255, 0.15);
  --sidebar-w: 236px;
  --topbar-h: 68px;
}

html[data-theme="shadow-purple"]{
  --bg: #08050f;
  --bg-deep: #030106;
  --bg-elevated: #120a24;
  --panel-bg: rgba(30, 15, 48, 0.62);
  --panel-bg-solid: #170c2c;
  --panel-border: rgba(178, 107, 255, 0.32);
  --panel-border-strong: rgba(178, 107, 255, 0.6);
  --accent-blue: #8a5bff;
  --accent-blue-2: #b06bff;
  --accent-purple: #ff6ec7;
  --accent-purple-2: #c026d3;
  --accent-gradient: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%);
  --shadow-glow: 0 0 24px rgba(178, 107, 255, 0.18);
}

html[data-theme="monarch-black"]{
  --bg: #030303;
  --bg-deep: #000000;
  --bg-elevated: #0a0a0a;
  --panel-bg: rgba(12, 12, 14, 0.68);
  --panel-bg-solid: #0c0c0e;
  --panel-border: rgba(255, 209, 102, 0.24);
  --panel-border-strong: rgba(255, 209, 102, 0.55);
  --accent-blue: #6d28d9;
  --accent-blue-2: #a855f7;
  --accent-purple: #ffd166;
  --accent-purple-2: #ff9f1c;
  --accent-gradient: linear-gradient(135deg, #7c3aed 0%, #ffd166 100%);
  --shadow-glow: 0 0 26px rgba(255, 209, 102, 0.14);
}

html[data-theme="light"]{
  --bg: #eef1fb;
  --bg-deep: #e3e7f7;
  --bg-elevated: #ffffff;
  --panel-bg: rgba(255, 255, 255, 0.72);
  --panel-bg-solid: #ffffff;
  --panel-border: rgba(59, 125, 255, 0.28);
  --panel-border-strong: rgba(59, 125, 255, 0.5);
  --accent-blue: #0ea5e9;
  --accent-blue-2: #3b7dff;
  --accent-purple: #9333ea;
  --accent-purple-2: #7c3aed;
  --accent-gradient: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%);
  --gold: #c98a00;
  --text-hi: #131a33;
  --text-mid: #4a5378;
  --text-dim: #838db3;
  --shadow-glow: 0 0 24px rgba(59, 125, 255, 0.12);
}

html, body { height: 100%; }
body{
  background: radial-gradient(ellipse at 20% -10%, rgba(41,211,255,0.10), transparent 45%),
              radial-gradient(ellipse at 90% 10%, rgba(176,107,255,0.10), transparent 40%),
              var(--bg);
  color: var(--text-hi);
  font-family: var(--font-body) !important;
  min-height: 100vh;
  overflow-x: hidden;
  transition: background 0.4s ease, color 0.4s ease;
}

button, input, select, option, textarea, label, table, td, th {
  font-family: var(--font-body) !important;
}

.hidden{ display: none !important; }

/* ---- Scrollbars ---- */
::-webkit-scrollbar{ width: 8px; height: 8px; }
::-webkit-scrollbar-track{ background: transparent; }
::-webkit-scrollbar-thumb{ background: var(--panel-border-strong); border-radius: 8px; }

/* ---- Typography helpers ---- */
.font-display{ font-family: var(--font-display) !important; }
.font-mono{ font-family: var(--font-mono) !important; }
.eyebrow{
  font-family: var(--font-display) !important;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent-blue);
  opacity: .85;
}
h1, h2, h3, h4, h5, h6 { font-family: var(--font-display) !important; font-weight: 700; letter-spacing: .3px; }

/* ============================================================
   FIRST LAUNCH / UPLOAD SCREEN
   ============================================================ */
#launch-screen{
  position: fixed; inset: 0; z-index: 500;
  display: flex; align-items: center; justify-content: center;
  background: radial-gradient(ellipse at 50% 20%, rgba(41,211,255,0.12), transparent 55%), var(--bg-deep);
  padding: 24px;
}
.launch-card{
  width: min(580px, 100%);
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  border-radius: var(--radius);
  backdrop-filter: blur(18px);
  padding: 42px 38px;
  text-align: center;
  position: relative;
  box-shadow: var(--shadow-glow), 0 20px 60px rgba(0,0,0,0.5);
}
.launch-glyph{
  width: 74px; height: 74px; margin: 0 auto 18px;
  border: 2px solid var(--accent-blue);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-size: 26px; font-weight: 700;
  color: var(--accent-blue);
  box-shadow: 0 0 30px rgba(41,211,255,0.45), inset 0 0 20px rgba(41,211,255,0.15);
  animation: pulse-ring 2.4s ease-in-out infinite;
}
@keyframes pulse-ring{
  0%,100%{ box-shadow: 0 0 20px rgba(41,211,255,0.35), inset 0 0 14px rgba(41,211,255,0.12); }
  50%{ box-shadow: 0 0 40px rgba(41,211,255,0.6), inset 0 0 24px rgba(41,211,255,0.25); }
}
.launch-card h1{ font-size: 26px; letter-spacing: 1px; margin-bottom: 8px; }
.launch-card p{ color: var(--text-mid); font-size: 14px; line-height: 1.6; margin-bottom: 24px; }
.dropzone{
  display: block;
  text-align: center;
  user-select: none;
  border: 1.5px dashed var(--panel-border-strong);
  border-radius: var(--radius-sm);
  padding: 28px 16px;
  cursor: pointer;
  transition: all .2s ease;
  margin-bottom: 16px;
}
.dropzone:hover, .dropzone.drag-over{
  border-color: var(--accent-blue);
  background: rgba(41,211,255,0.06);
  box-shadow: 0 0 16px rgba(41,211,255,0.15);
}
.dropzone strong{ color: var(--accent-blue); }
.dropzone .sub{ font-size: 12px; color: var(--text-dim); margin-top: 6px; }
.launch-footnote{ font-size: 11px; color: var(--text-dim); margin-top: 14px; }
.launch-progress{ margin-top: 18px; font-family: var(--font-mono); font-size: 13px; color: var(--accent-blue); }

.launch-actions{ display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }

/* ============================================================
   APP SHELL
   ============================================================ */
#app-shell{
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  grid-template-rows: var(--topbar-h) 1fr;
  grid-template-areas: "sidebar topbar" "sidebar main";
  min-height: 100vh;
}

/* ---- Sidebar ---- */
#sidebar{
  grid-area: sidebar;
  background: var(--bg-elevated);
  border-right: 1px solid var(--panel-border);
  padding: 20px 14px;
  display: flex; flex-direction: column;
  position: sticky; top: 0; height: 100vh; max-height: 100vh; z-index: 60;
  overflow: hidden;
}
.brand{
  display: flex; align-items: center; gap: 10px;
  padding: 6px 8px 22px; flex-shrink: 0;
}
.brand-mark{
  width: 36px; height: 36px; border-radius: 9px;
  background: var(--accent-gradient);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; color: #05060d; font-size: 14px;
  box-shadow: 0 0 18px rgba(41,211,255,0.4);
}
.brand-text{ font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: 1px; line-height: 1.15; }
.brand-text small{ display:block; font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); letter-spacing: 2px; font-weight: 400; }

.nav-list{ list-style: none; display: flex; flex-direction: column; gap: 4px; flex: 1; overflow-y: auto; overflow-x: hidden; padding-right: 2px; }
.nav-item{
  display: flex; align-items: center; gap: 12px;
  padding: 11px 12px; border-radius: var(--radius-sm);
  color: var(--text-mid); cursor: pointer; user-select: none;
  font-family: var(--font-display); font-weight: 600; font-size: 14.5px; letter-spacing: .4px;
  transition: all .15s ease; position: relative; flex-shrink: 0;
}
.nav-item .nav-ic{ width: 18px; text-align: center; font-size: 15px; }
.nav-item:hover{ background: rgba(255,255,255,0.04); color: var(--text-hi); }
.nav-item.active{
  color: var(--text-hi);
  background: linear-gradient(90deg, rgba(41,211,255,0.16), rgba(176,107,255,0.08));
  box-shadow: inset 2px 0 0 var(--accent-blue);
}
.nav-badge{
  margin-left: auto; font-family: var(--font-mono); font-size: 10px;
  background: rgba(255,77,109,0.18); color: var(--danger); padding: 1px 6px; border-radius: 10px;
}
.sidebar-foot{
  border-top: 1px solid var(--panel-border);
  padding-top: 14px; margin-top: 10px;
  font-size: 11px; color: var(--text-dim); text-align: center; font-family: var(--font-mono); flex-shrink: 0;
}

/* ---- Topbar ---- */
#topbar{
  grid-area: topbar;
  display: flex; align-items: center; gap: 18px;
  padding: 0 24px;
  border-bottom: 1px solid var(--panel-border);
  background: var(--bg-elevated);
  position: sticky; top: 0; z-index: 100;
  box-shadow: 0 4px 18px rgba(0,0,0,0.35);
}
.search-wrap{ position: relative; flex: 1; max-width: 360px; }
.search-wrap input{
  width: 100%; background: rgba(255,255,255,0.04); border: 1px solid var(--panel-border);
  border-radius: 20px; padding: 9px 16px 9px 34px; color: var(--text-hi); font-size: 13.5px;
  font-family: var(--font-body); outline: none; transition: border-color .15s;
}
.search-wrap input:focus{ border-color: var(--accent-blue); }
.search-wrap .ic{ position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-size: 13px; }

.topbar-spacer{ flex: 1; }

.rank-chip{
  display: flex; align-items: center; gap: 8px;
  padding: 5px 12px 5px 5px; border-radius: 20px;
  border: 1px solid var(--panel-border); background: rgba(255,255,255,0.03);
  cursor: default;
}
.rank-chip .rank-glyph{
  width: 26px; height: 26px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; font-size: 12px;
  background: var(--accent-gradient); color: #05060d;
}
.rank-chip .rank-info{ font-family: var(--font-mono); font-size: 11px; line-height: 1.2; }
.rank-chip .rank-info b{ display:block; font-size: 12.5px; color: var(--text-hi); font-family: var(--font-display); letter-spacing: .5px; }

.xp-mini{ width: 150px; }
.xp-mini .lbl{ display:flex; justify-content: space-between; font-family: var(--font-mono); font-size: 9.5px; color: var(--text-dim); margin-bottom: 3px; }
.xp-track{ height: 6px; border-radius: 4px; background: rgba(255,255,255,0.06); overflow: hidden; }
.xp-fill{ height: 100%; background: var(--accent-gradient); border-radius: 4px; box-shadow: 0 0 10px rgba(41,211,255,0.6); transition: width .6s cubic-bezier(.2,.8,.3,1); }

.icon-btn{
  width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--panel-border);
  background: rgba(255,255,255,0.03); color: var(--text-mid); cursor: pointer;
  display: flex; align-items: center; justify-content: center; font-size: 14px;
  transition: all .15s ease;
}
.icon-btn:hover{ color: var(--accent-blue); border-color: var(--accent-blue); box-shadow: 0 0 12px rgba(41,211,255,0.3); }

/* ---- Main ---- */
#main{ grid-area: main; padding: 26px 30px 60px; overflow-y: auto; max-height: calc(100vh - var(--topbar-h)); }
.view{ display: none; animation: fade-up .35s ease; }
.view.active{ display: block; }
@keyframes fade-up{ from{ opacity:0; transform: translateY(10px);} to{opacity:1; transform:none;} }

.view-header{ display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
.view-header h2{ font-size: 26px; }
.view-header .sub{ color: var(--text-mid); font-size: 13px; margin-top: 3px; }

/* ============================================================
   PANELS / CARDS
   ============================================================ */
.panel{
  background: var(--panel-bg);
  border: 1.5px solid var(--panel-border-strong);
  border-radius: var(--radius);
  backdrop-filter: blur(16px);
  padding: 20px;
  box-shadow: 0 0 20px rgba(0,0,0,0.5), 0 0 10px rgba(41,211,255,0.08), inset 0 0 16px rgba(41,211,255,0.04);
  position: relative;
}
.panel::before, .panel::after{ display: none !important; }

.panel-title{
  font-family: var(--font-display); font-weight: 800; font-size: 14px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--text-hi); margin-bottom: 14px;
  display: flex; align-items: center; gap: 8px;
  text-shadow: 0 0 10px rgba(41,211,255,0.6);
}
.panel-title .dot{ width:6px; height:6px; border-radius:50%; background: var(--accent-blue); box-shadow: 0 0 10px var(--accent-blue); }

/* ---- HUD System Window ---- */
.hud-window{
  position: relative;
  background: linear-gradient(160deg, rgba(16, 25, 55, 0.88), rgba(6, 10, 24, 0.92));
  border: 1.5px solid var(--accent-blue);
  border-radius: var(--radius);
  padding: 30px 32px;
  overflow: hidden;
  box-shadow: 0 0 30px rgba(41,211,255,0.25), inset 0 0 25px rgba(41,211,255,0.1);
}
.hud-window::before{
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: repeating-linear-gradient(180deg, rgba(41,211,255,0.035) 0px, rgba(41,211,255,0.035) 1px, transparent 1px, transparent 3px);
  mix-blend-mode: overlay; opacity: .5;
}
.hud-window::after{
  content: ""; position: absolute; left: 0; right: 0; height: 90px; top: -100%;
  background: linear-gradient(180deg, transparent, rgba(41,211,255,0.16), transparent);
  animation: scan-sweep 5s linear infinite;
}
@keyframes scan-sweep{ 0%{ top: -20%; } 100%{ top: 120%; } }
.hud-corner{ display: none !important; }

.hud-grid{ display: grid; grid-template-columns: 220px 1fr; gap: 34px; position: relative; z-index: 2; }
@media (max-width: 860px){ .hud-grid{ grid-template-columns: 1fr; justify-items: center; text-align: center; } }

.ring-wrap{ position: relative; width: 200px; height: 200px; margin: 0 auto; }
.ring-wrap svg{ transform: rotate(-90deg); }
.ring-bg{ fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 10; }
.ring-fg{ fill: none; stroke-width: 10; stroke-linecap: round; stroke: url(#ringGradient); filter: drop-shadow(0 0 8px rgba(41,211,255,0.7)); transition: stroke-dashoffset 1s cubic-bezier(.2,.8,.3,1); }
.ring-center{ position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring-center .pct{ font-family: var(--font-mono); font-size: 34px; font-weight: 700; color: var(--text-hi); }
.ring-center .lbl{ font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--text-dim); text-transform: uppercase; margin-top: 2px; }

.hud-stats{ display: flex; flex-direction: column; justify-content: center; gap: 16px; }
.rank-display{ display: flex; align-items: center; gap: 16px; }
.rank-badge-lg{
  width: 66px; height: 66px; border-radius: 16px;
  background: var(--accent-gradient);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 700; font-size: 26px; color: #05060d;
  box-shadow: 0 0 26px rgba(41,211,255,0.55);
  animation: rank-idle 3s ease-in-out infinite;
}
@keyframes rank-idle{ 0%,100%{ transform: scale(1);} 50%{ transform: scale(1.045);} }
.rank-display .info b{ font-family: var(--font-display); font-size: 22px; letter-spacing: .5px; display:block; }
.rank-display .info span{ font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim); }

.stat-grid-inline{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 6px; }
.stat-mini .v{ font-family: var(--font-mono); font-size: 20px; font-weight: 700; color: var(--accent-blue); }
.stat-mini .k{ font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; color: var(--text-dim); text-transform: uppercase; }

/* ---- Dashboard grid ---- */
.dash-grid{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 18px; }
@media (max-width: 1100px){ .dash-grid{ grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 620px){ .dash-grid{ grid-template-columns: 1fr; } }
.stat-card{ position: relative; overflow: hidden; }
.stat-card .icon{ font-size: 20px; color: var(--accent-blue); margin-bottom: 10px; }
.stat-card .val{ font-family: var(--font-mono); font-size: 26px; font-weight: 700; }
.stat-card .lab{ font-size: 12px; color: var(--text-mid); margin-top: 2px; }
.stat-card .trend{ font-family: var(--font-mono); font-size: 11px; margin-top: 8px; color: var(--success); }

/* ---- Practice log cards ---- */
.practice-card{ display:flex; flex-direction:column; }
.practice-card .subj-name{ font-family: var(--font-display); font-weight:700; font-size:16px; margin-bottom:8px; }
.practice-card .subj-total{ font-family: var(--font-mono); font-size:28px; font-weight:700; color: var(--accent-blue); }
.practice-card .subj-total-lab{ font-size:11.5px; color: var(--text-dim); margin-bottom:12px; }
.practice-input-row{ display:flex; gap:8px; margin-top:auto; }
.practice-input-row input{ width:0; flex:1; background: rgba(255,255,255,0.04); border:1px solid var(--panel-border); border-radius:8px; color:var(--text-hi); padding:9px 10px; font-family: var(--font-mono); font-size:13.5px; text-align:center; }
.practice-input-row input:focus{ outline:none; border-color: var(--accent-blue); }

.dash-row{ display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin-top: 16px; }
@media (max-width: 900px){ .dash-row{ grid-template-columns: 1fr; } }

/* ---- Heatmap ---- */
.heatmap{ display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); grid-auto-columns: 12px; gap: 3px; overflow-x: auto; padding-bottom: 4px; }
.heatmap .cell{ width: 12px; height: 12px; border-radius: 2px; background: rgba(255,255,255,0.05); }
.heatmap .cell[data-lvl="1"]{ background: rgba(41,211,255,0.25); }
.heatmap .cell[data-lvl="2"]{ background: rgba(41,211,255,0.5); }
.heatmap .cell[data-lvl="3"]{ background: rgba(41,211,255,0.75); }
.heatmap .cell[data-lvl="4"]{ background: var(--accent-blue); box-shadow: 0 0 6px var(--accent-blue); }
.heatmap-legend{ display:flex; align-items:center; gap:6px; margin-top:10px; font-size:10px; color: var(--text-dim); font-family: var(--font-mono); }
.heatmap-legend .cell{ width:10px; height:10px; border-radius:2px; }

/* ============================================================
   CHECKLIST TREE
   ============================================================ */
.toolbar{ display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.filter-chip{
  padding: 6px 13px; border-radius: 16px; border: 1px solid var(--panel-border);
  background: rgba(255,255,255,0.03); color: var(--text-mid); font-size: 12.5px; cursor: pointer;
  font-family: var(--font-display); font-weight: 600; letter-spacing: .3px; transition: all .15s;
}
.filter-chip:hover{ color: var(--text-hi); }
.filter-chip.active{ background: var(--accent-gradient); color: #05060d; border-color: transparent; }
.select-mini{
  background: var(--panel-bg-solid); border: 1px solid var(--panel-border); border-radius: 16px;
  color: var(--text-hi); font-size: 12.5px; padding: 6px 10px; font-family: var(--font-body);
}
select option, .select-mini option{
  color: #05060d !important;
  background-color: #ffffff !important;
  font-weight: 600;
}

.subject-block{ margin-bottom: 14px; }
.subject-head{
  display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer;
  border-radius: var(--radius-sm); background: var(--panel-bg); border: 1px solid var(--panel-border);
}
.subject-head .chev{ transition: transform .2s; color: var(--accent-blue); font-size: 12px; }
.subject-head.open .chev{ transform: rotate(90deg); }
.subject-head .name{ font-family: var(--font-display); font-weight: 700; font-size: 16.5px; flex: 1; }
.subject-head .cnt{ font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim); }
.subject-progress-track{ width: 90px; height: 5px; border-radius: 4px; background: rgba(255,255,255,0.07); overflow: hidden; }
.subject-progress-fill{ height: 100%; background: var(--accent-gradient); }

.category-block{ margin: 8px 0 0 20px; border-left: 1px dashed var(--panel-border); padding-left: 16px; }
.category-block.closed .topic-list{ display: none; }
.category-head{ display: flex; align-items: center; gap: 10px; padding: 9px 0; cursor: pointer; }
.category-head .chev{ transition: transform .2s; color: var(--accent-purple); font-size: 10px; }
.category-head.open .chev{ transform: rotate(90deg); }
.category-head .name{ font-family: var(--font-display); font-weight: 600; font-size: 14.5px; flex:1; color: var(--text-hi); }
.category-head .cnt{ font-family: var(--font-mono); font-size: 10.5px; color: var(--text-dim); }

.topic-row{
  display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 8px;
  margin: 3px 0; transition: background .15s;
}
.topic-row:hover{ background: rgba(255,255,255,0.03); }
.topic-name{ flex: 1; font-size: 13.5px; cursor: pointer; }
.topic-name.done{ color: var(--text-dim); }
.topic-name .bm{ color: var(--gold); margin-right: 5px; }
.item-chips{ display: flex; gap: 6px; }
.item-chip{
  width: 26px; height: 26px; border-radius: 7px; border: 1px solid var(--panel-border);
  display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 10px;
  color: var(--text-dim); font-family: var(--font-mono); transition: all .15s; position: relative;
}
.item-chip:hover{ border-color: var(--accent-blue); color: var(--accent-blue); }
.item-chip.checked{ background: var(--accent-gradient); color: #05060d; border-color: transparent; box-shadow: 0 0 10px rgba(41,211,255,0.5); }
.topic-progress{ width: 46px; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-dim); text-align: right; }

/* ---- Item detail drawer ---- */
#item-drawer{
  position: fixed; top: 0; right: 0; height: 100vh; width: 380px; max-width: 92vw;
  background: var(--bg-elevated); border-left: 1px solid var(--panel-border);
  z-index: 200; transform: translateX(100%); transition: transform .3s cubic-bezier(.2,.8,.3,1);
  padding: 24px; overflow-y: auto; box-shadow: -20px 0 50px rgba(0,0,0,0.5);
}
#item-drawer.open{ transform: translateX(0); }
#drawer-overlay{ position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 199; opacity:0; pointer-events:none; transition: opacity .3s; }
#drawer-overlay.open{ opacity:1; pointer-events:auto; }
.drawer-close{ position: absolute; top: 18px; right: 18px; cursor:pointer; color: var(--text-dim); font-size: 18px; }
.drawer-eyebrow{ font-family: var(--font-mono); font-size: 10.5px; color: var(--accent-blue); letter-spacing: 2px; text-transform: uppercase; }
.drawer-title{ font-size: 20px; margin: 6px 0 20px; }
.field-group{ margin-bottom: 16px; }
.field-group label{ display:block; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
.field-group textarea, .field-group select, .field-group input[type=text]{
  width: 100%; background: rgba(255,255,255,0.04); border: 1px solid var(--panel-border); border-radius: 8px;
  color: var(--text-hi); padding: 9px 11px; font-family: var(--font-body); font-size: 13px; outline: none;
}
.field-group textarea{ min-height: 80px; resize: vertical; }
.field-group textarea:focus, .field-group select:focus{ border-color: var(--accent-blue); }
.stepper{ display: flex; align-items: center; gap: 10px; }
.stepper button{ width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--panel-border); background: rgba(255,255,255,0.04); color: var(--text-hi); cursor: pointer; }
.toggle-row{ display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--panel-border); }
.switch{ width: 40px; height: 22px; border-radius: 12px; background: rgba(255,255,255,0.08); position: relative; cursor: pointer; transition: background .2s; }
.switch.on{ background: var(--accent-gradient); }
.switch .knob{ width: 18px; height: 18px; border-radius: 50%; background: #fff; position: absolute; top: 2px; left: 2px; transition: left .2s; }
.switch.on .knob{ left: 20px; }
.checklist-items-mini{ display:flex; flex-direction:column; gap:8px; margin-top: 6px;}
.drive-status{ display:flex; align-items:center; gap:8px; font-size:12px; color: var(--text-mid); margin: 10px 0 4px; }
.drive-status .dot{ width:8px; height:8px; border-radius:50%; background: var(--text-dim); flex-shrink:0; }
.drive-status.connected .dot{ background: var(--success); box-shadow: 0 0 8px var(--success); }
.drive-status.error .dot{ background: var(--danger); box-shadow: 0 0 8px var(--danger); }
.streak-stat.at-risk .v{ color: var(--danger) !important; animation: streak-pulse 1.6s ease-in-out infinite; }
@keyframes streak-pulse{ 0%,100%{ opacity:1; } 50%{ opacity:.55; } }
.mini-item-row{ display:flex; align-items:center; gap:10px; font-size: 12.5px; padding: 8px 10px; border-radius:8px; background: rgba(255,255,255,0.03); }
.mini-item-row .xp-tag{ margin-left:auto; font-family: var(--font-mono); font-size: 10px; color: var(--gold); }

/* ============================================================
   BUTTONS
   ============================================================ */
.btn{
  font-family: var(--font-display); font-weight: 700; letter-spacing: .4px; font-size: 13.5px;
  padding: 10px 20px; border-radius: 10px; border: 1px solid transparent; cursor: pointer;
  display: inline-flex; align-items: center; gap: 8px; transition: all .15s ease;
}
.btn-primary{ background: var(--accent-gradient); color: #05060d; box-shadow: 0 0 18px rgba(41,211,255,0.35); }
.btn-primary:hover{ filter: brightness(1.1); transform: translateY(-1px); }
.btn-ghost{ background: rgba(255,255,255,0.04); color: var(--text-hi); border-color: var(--panel-border); }
.btn-ghost:hover{ border-color: var(--accent-blue); color: var(--accent-blue); }
.btn-danger{ background: rgba(255,77,109,0.12); color: var(--danger); border-color: rgba(255,77,109,0.3); }
.btn-danger:hover{ background: rgba(255,77,109,0.2); }
.btn-sm{ padding: 7px 14px; font-size: 12px; }
.btn:disabled{ opacity: .45; cursor: not-allowed; }

/* ============================================================
   QUESTS & ACHIEVEMENTS & TIMER & SETTINGS
   ============================================================ */
.quest-grid{ display: grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap: 14px; }
.quest-card{ position: relative; }
.quest-card .qtitle{ font-family: var(--font-display); font-weight: 700; font-size: 15px; display:flex; align-items:center; gap:8px; }
.quest-card .qdesc{ font-size: 12px; color: var(--text-mid); margin: 6px 0 12px; }
.quest-track{ height: 7px; border-radius: 5px; background: rgba(255,255,255,0.06); overflow: hidden; margin-bottom: 8px; }
.quest-fill{ height: 100%; background: var(--accent-gradient); transition: width .4s; }
.quest-foot{ display: flex; justify-content: space-between; align-items:center; font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); }
.quest-reward{ color: var(--gold); }
.quest-card.complete{ border-color: var(--success); }
.quest-card.complete::after{ content: "✓ COMPLETE"; position: absolute; top: 14px; right: 16px; font-family: var(--font-mono); font-size: 10px; color: var(--success); letter-spacing: 1px; }

.ach-grid{ display: grid; grid-template-columns: repeat(auto-fill, minmax(230px,1fr)); gap: 14px; }
.ach-card{ text-align: center; padding: 22px 16px; position: relative; opacity: .45; filter: grayscale(1); transition: all .3s; }
.ach-card.unlocked{ opacity: 1; filter: none; }
.ach-icon{ width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 12px; display:flex; align-items:center; justify-content:center; font-size:24px; background: rgba(255,255,255,0.05); border: 1px solid var(--panel-border); }
.ach-card.unlocked .ach-icon{ background: var(--accent-gradient); box-shadow: 0 0 18px rgba(41,211,255,0.4); }
.ach-name{ font-family: var(--font-display); font-weight: 700; font-size: 14px; }
.ach-desc{ font-size: 11.5px; color: var(--text-dim); margin-top: 4px; }
.ach-date{ font-family: var(--font-mono); font-size: 10px; color: var(--gold); margin-top: 8px; }

.chart-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 900px){ .chart-grid{ grid-template-columns: 1fr; } }
.chart-box{ height: 260px; position: relative; }
.full-heatmap{ display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 1fr); grid-auto-columns: 13px; gap: 3px; overflow-x: auto; padding-bottom: 6px; }
.full-heatmap .cell{ width: 13px; height: 13px; border-radius: 2px; background: rgba(255,255,255,0.05); }

.timer-layout{ display: grid; grid-template-columns: 340px 1fr; gap: 20px; }
@media (max-width: 900px){ .timer-layout{ grid-template-columns: 1fr; } }
.timer-ring-wrap{ position: relative; width: 260px; height: 260px; margin: 10px auto; }
.timer-ring-wrap svg{ transform: rotate(-90deg); }
.timer-center{ position: absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.timer-center .time{ font-family: var(--font-mono); font-size: 42px; font-weight: 700; }
.timer-center .mode{ font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); letter-spacing: 2px; text-transform: uppercase; margin-top: 4px; }
.timer-modes{ display: flex; gap: 8px; justify-content: center; margin-top: 18px; flex-wrap: wrap; }
.timer-controls{ display: flex; gap: 10px; justify-content: center; margin-top: 18px; }
.session-log{ max-height: 380px; overflow-y: auto; }
.session-row{ display:flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--panel-border); font-size: 12.5px; }
.session-row .dur{ font-family: var(--font-mono); color: var(--accent-blue); }

.settings-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 900px){ .settings-grid{ grid-template-columns: 1fr; } }
.settings-row{ display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--panel-border); }
.settings-row:last-child{ border-bottom: none; }
.settings-row .lab{ font-size: 13.5px; }
.settings-row .desc{ font-size: 11.5px; color: var(--text-dim); margin-top: 2px; }
.theme-swatches{ display: flex; gap: 10px; }
.theme-swatch{ width: 34px; height: 34px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
.theme-swatch.active{ border-color: var(--text-hi); }
.xp-config-row{ display: flex; align-items: center; justify-content: space-between; padding: 8px 0; }
.xp-config-row input{ width: 70px; background: rgba(255,255,255,0.04); border: 1px solid var(--panel-border); border-radius: 6px; color: var(--text-hi); padding: 6px 8px; font-family: var(--font-mono); text-align: center; }

/* ============================================================
   NOTIFICATIONS / TOASTS / FX
   ============================================================ */
#toast-stack{ position: fixed; top: 20px; right: 20px; z-index: 900; display: flex; flex-direction: column; gap: 10px; width: 320px; max-width: 90vw; }
.toast{
  background: var(--panel-bg-solid); border: 1px solid var(--panel-border-strong); border-radius: 10px;
  padding: 13px 16px; display: flex; align-items: center; gap: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  animation: toast-in .3s cubic-bezier(.2,.8,.3,1);
}
.toast.leaving{ animation: toast-out .25s ease forwards; }
@keyframes toast-in{ from{ opacity:0; transform: translateX(40px);} to{opacity:1; transform:none;} }
@keyframes toast-out{ to{ opacity:0; transform: translateX(40px);} }
.toast .ic{ font-size: 18px; }
.toast .tt{ font-family: var(--font-display); font-weight: 700; font-size: 13px; }
.toast .tb{ font-size: 11.5px; color: var(--text-mid); }
.toast.xp .ic{ color: var(--accent-blue); }
.toast.quest .ic{ color: var(--success); }
.toast.rank .ic{ color: var(--gold); }
.toast.ach .ic{ color: var(--gold); }

.xp-float{
  position: fixed; z-index: 950; font-family: var(--font-mono); font-weight: 700; color: var(--accent-blue);
  pointer-events: none; animation: xp-float-anim 1.1s ease forwards; font-size: 15px;
  text-shadow: 0 0 10px rgba(41,211,255,0.8);
}
@keyframes xp-float-anim{ 0%{ opacity:0; transform: translateY(0);} 15%{opacity:1;} 100%{ opacity:0; transform: translateY(-46px); } }

.fx-overlay{
  position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center;
  background: rgba(3,4,10,0.75); backdrop-filter: blur(6px); opacity: 0; pointer-events: none; transition: opacity .3s;
}
.fx-overlay.show{ opacity: 1; pointer-events: auto; }
.fx-card{ text-align: center; transform: scale(.85); transition: transform .4s cubic-bezier(.2,.9,.25,1.4); }
.fx-overlay.show .fx-card{ transform: scale(1); }
.fx-card .fx-eyebrow{ font-family: var(--font-mono); letter-spacing: 6px; color: var(--accent-blue); font-size: 13px; }
.fx-card .fx-title{ font-family: var(--font-display); font-size: 54px; font-weight: 700; background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; margin: 6px 0; filter: drop-shadow(0 0 20px rgba(41,211,255,0.5)); }
.fx-card .fx-sub{ color: var(--text-mid); font-size: 14px; }
.fx-card .fx-badge{ width: 110px; height: 110px; border-radius: 26px; margin: 20px auto; background: var(--accent-gradient); display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-size: 44px; color: #05060d; box-shadow: 0 0 60px rgba(41,211,255,0.6); }

.ach-popup{
  position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-120%); z-index: 950;
  background: var(--panel-bg-solid); border: 1px solid var(--gold); border-radius: 12px; padding: 16px 24px;
  display: flex; align-items: center; gap: 14px; box-shadow: 0 0 40px rgba(255,209,102,0.35);
  transition: transform .4s cubic-bezier(.2,.9,.25,1.4);
}
.ach-popup.show{ transform: translateX(-50%) translateY(0); }
.ach-popup .ach-icon{ width: 48px; height: 48px; font-size: 22px; }

.empty-state{ text-align: center; padding: 50px 20px; color: var(--text-dim); }
.empty-state .ic{ font-size: 36px; margin-bottom: 10px; opacity:.6; }
.mt-16{ margin-top:16px; } .mt-24{ margin-top:24px; }
.flex-between{ display:flex; align-items:center; justify-content:space-between; }
.small-note{ font-size: 11px; color: var(--text-dim); }

@media (max-width: 860px){
  #app-shell{ grid-template-columns: 1fr; grid-template-areas: "topbar" "main"; }
  #sidebar{ position: fixed; left: 0; bottom: 0; top: auto; height: auto; width: 100%; flex-direction: row;
    padding: 8px 6px; border-right: none; border-top: 1px solid var(--panel-border); z-index: 300; overflow-x: auto; }
  .brand, .sidebar-foot{ display: none; }
  .nav-list{ flex-direction: row; flex:1; justify-content: space-around; }
  .nav-item{ flex-direction: column; font-size: 9.5px; padding: 6px 8px; gap: 3px; }
  .nav-item .nav-ic{ font-size: 16px; }
  #main{ padding: 18px 14px 90px; max-height: none; }
  .xp-mini{ display: none; }
}

@media (prefers-reduced-motion: reduce){
  *{ animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
}
html.no-animations *{
  animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important;
}
</style>
</head>
<body>
<!-- ============================================================
     APP SHELL
     ============================================================ -->
<div id="app-shell" class="hidden">

  <aside id="sidebar">
    <div class="brand" style="display:flex; align-items:center; justify-content:center; padding:16px 10px 24px;">
      <img src="logo.png" alt="Study Leveling" style="max-height:85px; width:auto; max-width:95%; filter:drop-shadow(0 0 22px rgba(41,211,255,0.8)); object-fit:contain; display:block;">
    </div>
    <ul class="nav-list">
      <li class="nav-item active" data-view="dashboard"><span class="nav-ic">&#9673;</span><span>Dashboard</span></li>
      <li class="nav-item" data-view="quests"><span class="nav-ic">&#9873;</span><span>Daily Quests</span><span class="nav-badge hidden" id="quest-badge">0</span></li>
      <li class="nav-item" data-view="achievements"><span class="nav-ic">&#9733;</span><span>Achievements</span></li>
      <li class="nav-item" data-view="statistics"><span class="nav-ic">&#9737;</span><span>Statistics</span></li>
      <li class="nav-item" data-view="timer"><span class="nav-ic">&#9201;</span><span>Focus Timer</span></li>
      <li class="nav-item" data-view="quiz-engine"><span class="nav-ic">&#9878;</span><span>Quiz Engine</span></li>
      <li class="nav-item" data-view="question-banks"><span class="nav-ic">&#128218;</span><span>Question Banks</span></li>
      <li class="nav-item" data-view="resources"><span class="nav-ic">&#128279;</span><span>Resources</span></li>
      <li class="nav-item" data-view="settings"><span class="nav-ic">&#9881;</span><span>Settings</span></li>
    </ul>
    <div class="sidebar-foot">STUDY LOG v2.0</div>
  </aside>

  <header id="topbar">
    <div class="search-wrap">
      <span class="ic">&#128269;</span>
      <input type="text" id="global-search" placeholder="Search question banks...">
    </div>
    <div class="topbar-spacer"></div>
    <div class="xp-mini">
      <div class="lbl"><span>XP</span><span id="topbar-xp-text">0 / 100</span></div>
      <div class="xp-track"><div class="xp-fill" id="topbar-xp-fill" style="width:0%"></div></div>
    </div>
    <div class="rank-chip">
      <div class="rank-glyph" id="topbar-rank-glyph">E</div>
      <div class="rank-info"><b id="topbar-rank-name">E-Rank</b><span id="topbar-rank-sub">Awakened Hunter</span></div>
    </div>
    <button class="icon-btn" id="btn-sound" title="Toggle sound">&#128266;</button>
    <button class="icon-btn" id="btn-theme" title="Cycle theme">&#9681;</button>
  </header>

  <main id="main">

    <!-- ===================== DASHBOARD ===================== -->
    <section class="view active" id="view-dashboard">
      <div class="view-header">
        <div>
          <div class="eyebrow">STATUS WINDOW</div>
          <h2>Hunter Dashboard</h2>
        </div>
        <div class="sub" id="dash-date"></div>
      </div>

      <div class="hud-window">
        <span class="hud-corner tl"></span><span class="hud-corner tr"></span><span class="hud-corner bl"></span><span class="hud-corner br"></span>
        <div class="hud-grid">
          <div class="ring-wrap">
            <svg viewBox="0 0 200 200" width="200" height="200">
              <defs>
                <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color: var(--accent-blue)"/>
                  <stop offset="100%" style="stop-color: var(--accent-purple)"/>
                </linearGradient>
              </defs>
              <circle class="ring-bg" cx="100" cy="100" r="88"></circle>
              <circle class="ring-fg" id="dash-ring" cx="100" cy="100" r="88" stroke-dasharray="553" stroke-dashoffset="553"></circle>
            </svg>
            <div class="ring-center">
              <div class="pct" id="dash-pct">0%</div>
              <div class="lbl">Bank Mastery</div>
            </div>
          </div>
          <div class="hud-stats">
            <div class="rank-display">
              <div class="rank-badge-lg" id="dash-rank-badge">E</div>
              <div class="info">
                <b id="dash-rank-name">E-Rank Hunter</b>
                <span id="dash-xp-text">0 XP · Next rank at 100 XP</span>
              </div>
            </div>
            <div class="stat-grid-inline" style="grid-template-columns: repeat(4, 1fr);">
              <div class="stat-mini"><div class="v" id="dash-today-xp" style="color:var(--gold);">+0</div><div class="k">Today's XP</div></div>
              <div class="stat-mini"><div class="v" id="dash-today-quizzes" style="color:var(--accent-purple);">0</div><div class="k">Today's Quizzes</div></div>
              <div class="stat-mini"><div class="v" id="dash-today-time" style="color:var(--accent-cyan);">0m</div><div class="k">Study Time</div></div>
              <div class="stat-mini streak-stat" id="dash-streak-stat" title="Study today to keep your streak alive"><div class="v" id="dash-streak">0</div><div class="k">Day Streak</div></div>
              <div class="stat-mini"><div class="v" id="dash-today">0</div><div class="k">Mastered</div></div>
              <div class="stat-mini"><div class="v" id="dash-remaining">0</div><div class="k">Unmastered</div></div>
              <div class="stat-mini"><div class="v" id="dash-total">0</div><div class="k">Total Questions</div></div>
              <div class="stat-mini"><div class="v" id="dash-eta">—</div><div class="k">Active Banks</div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="dash-grid" style="grid-template-columns: repeat(4, 1fr);">
        <div class="panel stat-card" id="card-review-queue" style="border-color:rgba(184,41,255,0.4); cursor:pointer;" title="Click to start Review Queue">
          <div class="icon" style="color:var(--accent-purple);">&#9878;</div>
          <div class="val" id="card-review-due" style="color:var(--accent-purple);">0</div>
          <div class="lab">Questions Due Today</div>
          <div class="trend" id="card-review-sub" style="color:var(--text-mid);">0 Total Important</div>
        </div>
        <div class="panel stat-card" style="border-color:rgba(255,77,109,0.3);">
          <div class="icon" style="color:var(--danger);">&#9888;</div>
          <div class="val" id="card-important-count" style="color:var(--danger);">0</div>
