/* ---- Duplicate Detection System ---- */
const DuplicateDetector = (function(){
  function normalizeText(txt){
    return String(txt||'').toLowerCase().replace(/[^a-z0-9]/g, '').trim();
  }

  function findDuplicates(questions){
    const map = new Map();
    const duplicates = [];
    (questions||[]).forEach(q => {
      const norm = normalizeText(q.questionText || q.question);
      if(!norm) return;
      if(map.has(norm)){
        duplicates.push({ original: map.get(norm), duplicate: q });
      } else {
        map.set(norm, q);
      }
    });
    return duplicates;
  }

  return { normalizeText, findDuplicates };
})();

/* ---- Question Bank Excel Importer ---- */
const ExcelImporter = (function(){
  function detectColumns(headers){
    const cells = headers.map(c => String(c||'').trim().toLowerCase());
    return {
      question: cells.findIndex(c => c.includes('question') || c.includes('prompt') || c === 'q' || c === 'stem'),
      optionA: cells.findIndex(c => c.includes('option a') || c === 'a' || c === 'optiona'),
      optionB: cells.findIndex(c => c.includes('option b') || c === 'b' || c === 'optionb'),
      optionC: cells.findIndex(c => c.includes('option c') || c === 'c' || c === 'optionc'),
      optionD: cells.findIndex(c => c.includes('option d') || c === 'd' || c === 'optiond'),
      answer: cells.findIndex(c => c.includes('answer') || c.includes('correct') || c === 'ans' || c === 'key'),
      topic: cells.findIndex(c => c.includes('topic') || c.includes('category') || c.includes('domain') || c.includes('subject')),
      difficulty: cells.findIndex(c => c.includes('difficulty') || c.includes('diff') || c.includes('level')),
      explanation: cells.findIndex(c => c.includes('explanation') || c.includes('solution') || c.includes('rationale') || c.includes('notes'))
    };
  }

  function parseSheetQuestions(rows, sheetName, defaultTopic, bankId, bankFileName){
    if(!rows || !rows.length) return { questions: [], warnings: [] };
    let headerIdx = -1;
    let colMap = null;
    const warnings = [];

    for(let i = 0; i < Math.min(15, rows.length); i++){
      const r = rows[i] || [];
      const colDetection = detectColumns(r);
      if(colDetection.question !== -1){
        headerIdx = i;
        colMap = colDetection;
        break;
      }
    }

    if(headerIdx === -1){
      headerIdx = 0;
      colMap = { question:0, optionA:1, optionB:2, optionC:3, optionD:4, answer:5, topic:6, difficulty:7, explanation:8 };
    }

    const questions = [];
    for(let r = headerIdx + 1; r < rows.length; r++){
      const row = rows[r] || [];
      const qText = String(row[colMap.question]||'').trim();
      if(!qText) continue;

      const optA = colMap.optionA !== -1 ? String(row[colMap.optionA]||'').trim() : '';
      const optB = colMap.optionB !== -1 ? String(row[colMap.optionB]||'').trim() : '';
      const optC = colMap.optionC !== -1 ? String(row[colMap.optionC]||'').trim() : '';
      const optD = colMap.optionD !== -1 ? String(row[colMap.optionD]||'').trim() : '';

      const rawAns = colMap.answer !== -1 ? String(row[colMap.answer]||'').trim() : '';
      const topicVal = colMap.topic !== -1 && row[colMap.topic] ? String(row[colMap.topic]).trim() : (defaultTopic || sheetName || 'General Engineering');
      const diffVal = colMap.difficulty !== -1 && row[colMap.difficulty] ? String(row[colMap.difficulty]).trim().toLowerCase() : 'medium';
      const explVal = colMap.explanation !== -1 && row[colMap.explanation] ? String(row[colMap.explanation]).trim() : '';

      const options = [];
      if(optA) options.push({ id:'opt_1', text: optA });
      if(optB) options.push({ id:'opt_2', text: optB });
      if(optC) options.push({ id:'opt_3', text: optC });
      if(optD) options.push({ id:'opt_4', text: optD });
      if(!options.length){
        options.push({ id:'opt_1', text:'True' }, { id:'opt_2', text:'False' });
      }

      let correctOptId = options[0].id;
      const lowerRaw = rawAns.toLowerCase();
      if(lowerRaw === 'a' || lowerRaw === 'option a' || lowerRaw === '1') correctOptId = options[0] ? options[0].id : 'opt_1';
      else if(lowerRaw === 'b' || lowerRaw === 'option b' || lowerRaw === '2') correctOptId = options[1] ? options[1].id : 'opt_2';
      else if(lowerRaw === 'c' || lowerRaw === 'option c' || lowerRaw === '3') correctOptId = options[2] ? options[2].id : 'opt_3';
      else if(lowerRaw === 'd' || lowerRaw === 'option d' || lowerRaw === '4') correctOptId = options[3] ? options[3].id : 'opt_4';
      else {
        const matched = options.find(o => o.text.trim().toLowerCase() === lowerRaw);
        if(matched) correctOptId = matched.id;
      }

      const validDiff = ['easy','medium','hard'].includes(diffVal) ? diffVal : 'medium';

      questions.push({
        id: uid('q'),
        bankId,
        bankFileName,
        topic: topicVal,
        questionText: qText,
        options,
        correctAnswerId: correctOptId,
        correctText: (options.find(o => o.id === correctOptId)||options[0]).text,
        explanation: explVal,
        difficulty: validDiff
      });
    }

    return { questions, warnings };
  }

  function readBankFile(file, overrideTopic){
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        try{
          const data = new Uint8Array(e.target.result);
          const wbData = XLSX.read(data, { type:'array' });
          const bankId = uid('qb');
          const fileName = file.name;
          let allQuestions = [];
          let allWarnings = [];

          wbData.SheetNames.forEach(sheetName => {
            const ws = wbData.Sheets[sheetName];
            const rows = XLSX.utils.sheet_to_json(ws, { header:1, defval:null, blankrows:false });
            const res = parseSheetQuestions(rows, sheetName, overrideTopic, bankId, fileName);
            if(res.questions.length) allQuestions = allQuestions.concat(res.questions);
            if(res.warnings.length) allWarnings = allWarnings.concat(res.warnings);
          });

          if(!allQuestions.length){
            reject(new Error(`No valid questions found in "${file.name}". Ensure Question column is present.`));
            return;
          }

          const primaryTopic = overrideTopic || (allQuestions[0] ? allQuestions[0].topic : 'General Engineering');

          resolve({
            bank: {
              id: bankId,
              fileName,
              topic: primaryTopic,
              importedAt: new Date().toISOString(),
              disabled: false,
              questionCount: allQuestions.length,
              questions: allQuestions,
              validationWarnings: allWarnings
            },
            summary: { fileName, count: allQuestions.length, warnings: allWarnings.length }
          });
        }catch(err){ reject(err); }
      };
      reader.onerror = () => reject(new Error(`Failed to read "${file.name}"`));
      reader.readAsArrayBuffer(file);
    });
  }

  return { readBankFile };
})();

/* ---- Question Bank Manager ---- */
const QuestionBankManager = (function(){
  let _cachedMerged = null;
  function invalidateCache(){ _cachedMerged = null; }

  function getAllBanks(){ return STATE.questionBanks || []; }
  function getActiveBanks(){ return getAllBanks().filter(b => !b.disabled); }

  function getTopicsList(){
    const set = new Set();
    (STATE.topics||[]).forEach(t => { if(t) set.add(t); });
    getAllBanks().forEach(b => {
      if(b.topic) set.add(b.topic);
      (b.questions||[]).forEach(q => { if(q.topic) set.add(q.topic); });
    });
    return Array.from(set).sort();
  }

  // Explicitly-created topics only (for the Manage Topics list & assignment dropdowns).
  function getTopics(){
    STATE.topics = STATE.topics || [];
    return STATE.topics.slice().sort((a,b) => a.localeCompare(b));
  }

  function addTopic(name){
    const trimmed = (name || '').trim();
    if(!trimmed) return false;
    STATE.topics = STATE.topics || [];
    const exists = STATE.topics.some(t => t.toLowerCase() === trimmed.toLowerCase());
    if(exists) return false;
    STATE.topics.push(trimmed);
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
    return true;
  }

  function deleteTopic(name){
    STATE.topics = (STATE.topics || []).filter(t => t !== name);
    getAllBanks().forEach(b => {
      if(b.topic === name){
        b.topic = '';
        (b.questions || []).forEach(q => { if(q.topic === name) q.topic = ''; });
      }
    });
    invalidateCache();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
  }

  function setBankTopic(bankId, topic){
    const bank = getAllBanks().find(b => b.id === bankId);
    if(!bank) return;
    bank.topic = (topic || '').trim();
    (bank.questions || []).forEach(q => q.topic = bank.topic);
    invalidateCache();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
  }

  function renameBank(bankId, newName){
    const bank = getAllBanks().find(b => b.id === bankId);
    if(!bank || !newName || !newName.trim()) return;
    bank.fileName = newName.trim();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
  }

  function getMergedDatabase(){
    const banks = getActiveBanks();
    const seenHashes = new Set();
    const mergedQuestions = [];
    let duplicatesCount = 0;

    banks.forEach(b => {
      (b.questions || []).forEach(q => {
        const hash = DuplicateDetector.normalizeText(q.questionText);
        if(seenHashes.has(hash)){
          duplicatesCount++;
        } else {
          seenHashes.add(hash);
          mergedQuestions.push(q);
        }
      });
    });

    _cachedMerged = {
      mergedQuestions,
      duplicatesCount,
      totalBanksCount: getAllBanks().length,
      activeBanksCount: banks.length,
      totalUniqueCount: mergedQuestions.length
    };
    return _cachedMerged;
  }

  function getBankStats(bank){
    const questions = bank.questions || [];
    const diffs = { easy:0, medium:0, hard:0 };
    let attempted = 0, mastered = 0;

    questions.forEach(q => {
      diffs[q.difficulty || 'medium'] = (diffs[q.difficulty || 'medium'] || 0) + 1;
      const m = MasterySystem.getMastery(q.id);
      if(m.timesAttempted > 0) attempted++;
      if(m.masteryLevel === 'Mastered') mastered++;
    });

    const total = questions.length || 1;
    const progressPct = Math.round((mastered / total) * 100);

    return { total: questions.length, diffs, attempted, mastered, progressPct };
  }

  async function addBankFiles(files, overrideTopic){
    const fileList = Array.from(files);
    const reports = [];
    for(const f of fileList){
      try {
        const res = await ExcelImporter.readBankFile(f, overrideTopic);
        STATE.questionBanks.push(res.bank);
        reports.push(`✓ ${res.fileName} — ${res.count} questions imported.`);
      } catch(err) {
        reports.push(`⚠ ${f.name} — ${err.message}`);
      }
    }
    invalidateCache();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
    UI.renderStatistics();
    return reports;
  }

  function getQuestionById(qId){
    const banks = getAllBanks();
    for(let i=0; i<banks.length; i++){
      const found = (banks[i].questions || []).find(q => q.id === qId);
      if(found) return found;
    }
    return null;
  }

  // Auto-assigns difficulty from practice-mode performance:
  // answered correctly on the very first selection -> Easy
  // answered correctly but needed a 2nd selection -> Medium
  // needed 3+ selections, or never got it right -> Hard
  function autoAssignDifficulty(qId, attemptsUsed, wasCorrect){
    const q = getQuestionById(qId);
    if(!q) return;
    let newDifficulty;
    if(wasCorrect && attemptsUsed <= 1) newDifficulty = 'easy';
    else if(wasCorrect && attemptsUsed === 2) newDifficulty = 'medium';
    else newDifficulty = 'hard';
    q.difficulty = newDifficulty;
  }

  function editBankMetadata(bankId, newName, newTopic){
    const bank = getAllBanks().find(b => b.id === bankId);
    if(!bank) return;
    if(newName) bank.fileName = newName.trim();
    if(newTopic) {
      bank.topic = newTopic.trim();
      (bank.questions || []).forEach(q => q.topic = newTopic.trim());
    }
    invalidateCache();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
  }

  function deleteBank(bankId){
    if(!confirm('Are you sure you want to delete this question bank? Historical quiz attempt data will be preserved.')) return;
    STATE.questionBanks = getAllBanks().filter(b => b.id !== bankId);
    invalidateCache();
    persist();
    UI.renderQuestionBanks();
    UI.renderQuizSetupScreen();
    Notify.toast('info', 'Question Bank Deleted', 'Bank removed from library.');
  }

  function toggleBank(bankId){
    const bank = getAllBanks().find(b => b.id === bankId);
    if(bank){ bank.disabled = !bank.disabled; invalidateCache(); persist(); UI.renderQuestionBanks(); }
  }

  function clearAllBanks(){
    if(!confirm('Delete all imported question banks?')) return;
    STATE.questionBanks = []; invalidateCache(); persist(); UI.renderQuestionBanks();
  }

  return { getAllBanks, getActiveBanks, getTopicsList, getTopics, addTopic, deleteTopic, setBankTopic, renameBank, getQuestionById, autoAssignDifficulty, getMergedDatabase, getBankStats, addBankFiles, editBankMetadata, deleteBank, toggleBank, clearAllBanks, invalidateCache };
})();

/* ---- Quiz Engine ---- */
const QuizEngine = (function(){
  let timerInterval = null;

  function shuffle(arr){
    const pool = arr.slice();
    for(let i = pool.length - 1; i > 0; i--){
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool;
  }

  function getFallbackQuestions(){
    // No syllabus system exists anymore — with no question banks uploaded there is simply no pool.
    return [];
  }

  function getQuestionsForScope(scopeType, scopeValue){
    const dbData = QuestionBankManager.getMergedDatabase();
    let questions = dbData.mergedQuestions;

    if(scopeType === 'bank'){
      const bank = QuestionBankManager.getAllBanks().find(b => b.id === scopeValue);
      if(bank && bank.questions && bank.questions.length) questions = bank.questions;
    } else if(scopeType === 'topic'){
      questions = questions.filter(q => q.topic === scopeValue);
    }

    if(!questions || !questions.length) questions = getFallbackQuestions();
    return questions;
  }

  function filterQuestions(questions, selectionFilter){
    let filtered = questions.slice();

    if(selectionFilter === 'unattempted'){
      filtered = filtered.filter(q => MasterySystem.getMastery(q.id).timesAttempted === 0);
    } else if(selectionFilter === 'incorrect'){
      filtered = filtered.filter(q => {
        const m = MasterySystem.getMastery(q.id);
        return m.timesIncorrect > 0 && m.masteryLevel !== 'Mastered';
      });
    } else if(selectionFilter === 'attempted'){
      filtered = filtered.filter(q => MasterySystem.getMastery(q.id).timesAttempted > 0);
    } else if(selectionFilter === 'smart'){
      filtered.sort((a, b) => {
        const ma = MasterySystem.getMastery(a.id);
        const mb = MasterySystem.getMastery(b.id);
        const scoreA = (ma.timesIncorrect * 3) + (100 - ma.accuracy) + (ma.timesAttempted === 0 ? 50 : 0);
        const scoreB = (mb.timesIncorrect * 3) + (100 - mb.accuracy) + (mb.timesAttempted === 0 ? 50 : 0);
        return scoreB - scoreA;
      });
    }

    return filtered;
  }

  function createQuiz(config){
    const rawPool = getQuestionsForScope(config.scopeType || 'all', config.scopeValue || 'all');
    let pool = filterQuestions(rawPool, config.selectionFilter || 'all');

    if(!pool.length && rawPool.length){
      pool = rawPool;
      Notify.toast('info', 'Filters Adjusted', 'No exact matches found. Loaded available question pool.');
    }

    if(!pool.length){
      Notify.toast('info', 'No Questions Available', 'Upload a question bank first from the Question Banks view.');
      return null;
    }

    const availableCount = pool.length;
    let targetCount = config.count === 'all' ? availableCount : parseInt(config.count) || 20;

    if(targetCount > availableCount){
      targetCount = availableCount;
      Notify.toast('info', 'Question Count Capped', `Requested ${config.count} questions, capped at ${availableCount} available.`);
    }

    let selectedQuestions = pool.slice();
    if(config.selectionFilter === 'random' || config.shuffleQ){
      selectedQuestions = shuffle(selectedQuestions);
    }
    selectedQuestions = selectedQuestions.slice(0, targetCount);

    const preparedQuestions = selectedQuestions.map(q => {
      let opts = (q.options || []).map(o => ({ id: o.id, text: o.text }));
      if(config.shuffleC){
        opts = shuffle(opts);
      }
      return {
        id: q.id,
        bankId: q.bankId,
        bankFileName: q.bankFileName || 'Question Bank',
        topic: q.topic || 'General Topic',
        difficulty: q.difficulty || 'medium',
        questionText: q.questionText || q.question,
        options: opts,
        correctAnswerId: q.correctAnswerId,
        correctText: q.correctText,
        explanation: q.explanation || ''
      };
    });

    const session = {
      id: uid('quiz'),
      title: config.title || (config.scopeValue && config.scopeValue !== 'all' ? config.scopeValue : 'All Question Banks'),
      scopeType: config.scopeType || 'all',
      scopeValue: config.scopeValue || 'all',
      mode: config.mode || 'practice',
      feedbackTiming: config.feedbackTiming || 'immediate',
      questions: preparedQuestions,
      currentIndex: 0,
      answers: {},
      flags: {},
      timed: !!config.timed,
      timeRemaining: config.timed ? (preparedQuestions.length * 60) : 0,
      startedAt: new Date().toISOString()
    };

    STATE.activeQuiz = session;
    persist();
    return session;
  }

  function startTimerIfNeeded(){
    if(timerInterval) clearInterval(timerInterval);
    const quiz = STATE.activeQuiz;
    if(!quiz || !quiz.timed || quiz.isFinished) return;
    timerInterval = setInterval(() => {
      if(!STATE.activeQuiz || !STATE.activeQuiz.timed || STATE.activeQuiz.isFinished){ clearInterval(timerInterval); return; }
      STATE.activeQuiz.timeRemaining--;
      if(STATE.activeQuiz.timeRemaining <= 0){ finishQuiz(); }
      UI.renderQuizActiveScreen();
    }, 1000);
  }

  function submitChoice(optionId, eventCoords){
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished) return;
    const curIdx = quiz.currentIndex;
    const currentQ = quiz.questions[curIdx];
    if(!currentQ) return;

    quiz.attempts = quiz.attempts || {};
    quiz.clicksCount = quiz.clicksCount || {};
    const curAttempts = quiz.attempts[curIdx] || [];
    let curClicks = quiz.clicksCount[curIdx] || 0;

    const isExamMode = (quiz.mode === 'exam' || quiz.feedbackTiming === 'end');

    if(isExamMode){
      // Exam Mode / End-of-quiz feedback: freely select & change an answer per question,
      // save it, with no correct/incorrect reveal until the quiz is submitted.
      quiz.answers[curIdx] = optionId;
      curClicks++;
      if(!curAttempts.includes(optionId)) curAttempts.push(optionId);
      quiz.clicksCount[curIdx] = curClicks;
      quiz.attempts[curIdx] = curAttempts;
      Sound.play('click');
      persist();
      UI.renderQuizActiveScreen();
      return;
    }

    // Immediate Feedback Mode: Max 4 clicks per question, or until correct option found
    const isCorrectAlready = curAttempts.some(id => id === currentQ.correctAnswerId);
    if(curClicks >= 4 || isCorrectAlready) return;
    if(curAttempts.includes(optionId)) return; // Already tried this option

    curClicks++;
    curAttempts.push(optionId);
    quiz.clicksCount[curIdx] = curClicks;
    quiz.attempts[curIdx] = curAttempts;
    quiz.answers[curIdx] = optionId; // Stores user's latest choice

    const isCorrect = (optionId === currentQ.correctAnswerId);

    if(isCorrect){
      Sound.play('check');
      const qRate = STATE.settings.xpRates.question || 2;
      quiz.xpAwarded = quiz.xpAwarded || {};
      if(!quiz.xpAwarded[curIdx]){
        quiz.xpAwarded[curIdx] = qRate;
        XP.add(qRate, 'question', { silent: false, x: eventCoords && eventCoords.x, y: eventCoords && eventCoords.y });
      }
    } else {
      Sound.play('click');
      const remaining = 4 - curClicks;
      if(remaining > 0){
        const optIndex = currentQ.options ? currentQ.options.findIndex(o=>o.id===optionId) : -1;
        const letter = optIndex >= 0 ? String.fromCharCode(65 + optIndex) : '';
        Notify.toast('info', 'Incorrect Choice', `Option ${letter} is incorrect. ${remaining} try/tries remaining.`);
      } else {
        Notify.toast('info', '4 Clicks Reached', `Maximum 4 tries used. Correct answer: ${currentQ.correctText}`);
      }
    }

    persist();
    UI.renderQuizActiveScreen();
  }

  function toggleFlag(){
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished) return;
    quiz.flags[quiz.currentIndex] = !quiz.flags[quiz.currentIndex];
    const currentQ = quiz.questions[quiz.currentIndex];
    if(currentQ){
      getQuestionStats(currentQ.id).important = quiz.flags[quiz.currentIndex];
    }
    persist();
    UI.renderQuizActiveScreen();
    Notify.toast('info', quiz.flags[quiz.currentIndex] ? 'Question Flagged 🚩' : 'Flag Removed');
  }

  function prevQuestion(){
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished) return;
    if(quiz.currentIndex > 0){ quiz.currentIndex--; persist(); UI.renderQuizActiveScreen(); }
  }

  function nextQuestion(){
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished) return;
    if(quiz.currentIndex < quiz.questions.length - 1){ quiz.currentIndex++; persist(); UI.renderQuizActiveScreen(); }
  }

  function skipQuestion(){
    nextQuestion();
  }

  function finishQuiz(){
    if(timerInterval) clearInterval(timerInterval);
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished) return;

    let correctCount = 0;
    let incorrectCount = 0;
    let unansweredCount = 0;
    const isPracticeMode = !(quiz.mode === 'exam' || quiz.feedbackTiming === 'end');

    quiz.questions.forEach((q, idx) => {
      const attempts = (quiz.attempts && quiz.attempts[idx]) || [];
      const userChoiceId = quiz.answers[idx];
      const isCorrect = attempts.includes(q.correctAnswerId) || (userChoiceId === q.correctAnswerId);

      if(!attempts.length && !userChoiceId){
        unansweredCount++;
      } else {
        if(isCorrect) correctCount++;
        else incorrectCount++;
        MasterySystem.recordAttempt(q.id, isCorrect);
        // Only practice-mode attempts reflect genuine selection difficulty —
        // exam mode lets you freely revise your answer before submitting.
        if(isPracticeMode && attempts.length > 0){
          QuestionBankManager.autoAssignDifficulty(q.id, attempts.length, isCorrect);
        }
      }
    });

    const total = quiz.questions.length || 1;
    const scorePct = Math.round((correctCount / total) * 100);
    const timeSpentSec = Math.max(1, Math.round((Date.now() - new Date(quiz.startedAt).getTime()) / 1000));
    const avgTimePerQ = Math.round(timeSpentSec / total);

    // Practice-mode XP is already granted live as each correct answer is submitted
    // (see submitChoice) so the topbar updates in real time — don't re-award it here.
    // Exam mode has no live feedback, so its XP is granted once, in full, at submission.
    let xpEarned;
    if(isPracticeMode){
      const awarded = quiz.xpAwarded || {};
      xpEarned = Object.keys(awarded).reduce((sum, k) => sum + (awarded[k] || 0), 0);
    } else {
      xpEarned = correctCount * (STATE.settings.xpRates.question || 2);
    }

    quiz.isFinished = true;
    quiz.scorePct = scorePct;
    quiz.correctCount = correctCount;
    quiz.incorrectCount = incorrectCount;
    quiz.unansweredCount = unansweredCount;
    quiz.timeSpentSec = timeSpentSec;
    quiz.avgTimePerQ = avgTimePerQ;
    quiz.xpEarned = xpEarned;
    quiz.completedAt = new Date().toISOString();

    STATE.quizHistory = STATE.quizHistory || [];
    STATE.quizHistory.unshift(Object.assign({}, quiz));
    if(STATE.quizHistory.length > 100) STATE.quizHistory.length = 100;

    const d = todayStr();
    STATE.today.questionsAnswered = (STATE.today.questionsAnswered||0) + total;
    STATE.dailyQuestionsLog[d] = (STATE.dailyQuestionsLog[d]||0) + total;
    if(unansweredCount === 0 && incorrectCount === 0 && correctCount === total){
      STATE.today.perfectQuizzes = (STATE.today.perfectQuizzes || 0) + 1;
      STATE.perfectQuizTotal = (STATE.perfectQuizTotal || 0) + 1;
    }

    if(!isPracticeMode) XP.add(xpEarned, 'quiz', { silent: false });
    Activity.log(); Activity.refreshStreak(); Quests.refresh(); Achievements.check();
    persist();
    Sound.play('levelup');
    UI.renderQuizResultsScreen();
  }

  function discardSession(){
    if(timerInterval) clearInterval(timerInterval);
    STATE.activeQuiz = null;
    persist();
    const resumeBanner = document.getElementById('quiz-resume-banner');
    if(resumeBanner) resumeBanner.classList.add('hidden');
    UI.renderQuizSetupScreen();
    Notify.toast('info', 'Session Discarded', 'Quiz session cleared.');
  }

  function retryIncorrect(){
    const quiz = STATE.activeQuiz;
    if(!quiz || !quiz.isFinished) return;
    const incorrectQs = quiz.questions.filter((q, idx) => quiz.answers[idx] !== q.correctAnswerId);
    if(!incorrectQs.length){
      Notify.toast('info', 'No Incorrect Questions', 'You scored 100% on this quiz!');
      return;
    }
    createQuiz({
      title: `Retry Incorrect (${quiz.title})`,
      scopeType: quiz.scopeType,
      scopeValue: quiz.scopeValue,
      mode: quiz.mode,
      feedbackTiming: quiz.feedbackTiming,
      count: incorrectQs.length,
      selectionFilter: 'all'
    });
    UI.renderQuizActiveScreen();
  }

  return { createQuiz, submitChoice, toggleFlag, prevQuestion, nextQuestion, skipQuestion, finishQuiz, discardSession, retryIncorrect, startTimerIfNeeded, getFallbackQuestions };
})();

/* ---- Spaced Repetition Review Queue ---- */
const ReviewQueue = (function(){
  function getDueQuestions(){
    const today = todayStr();
    const dbData = QuestionBankManager.getMergedDatabase();
    const allQ = dbData.mergedQuestions && dbData.mergedQuestions.length ? dbData.mergedQuestions : QuizEngine.getFallbackQuestions();
    return allQ.filter(q => {
      const stats = getQuestionStats(q.id);
      if(!stats.important) return false;
      return !stats.nextReviewDate || stats.nextReviewDate <= today;
    });
  }
  function recordReviewRating(qId, rating){
    const stats = getQuestionStats(qId);
    let interval = stats.intervalDays || 1;
    let ease = stats.easeFactor || 2.5;
    if(rating === 'again') { interval = 1; ease = Math.max(1.3, ease - 0.2); }
    else if(rating === 'hard') { interval = Math.max(1, Math.round(interval * 1.2)); ease = Math.max(1.3, ease - 0.15); }
    else if(rating === 'good') { interval = Math.max(1, Math.round(interval * ease)); }
    else if(rating === 'easy') { interval = Math.max(2, Math.round(interval * ease * 1.3)); ease = Math.min(3.5, ease + 0.15); }

    const nextDate = new Date(); nextDate.setDate(nextDate.getDate() + interval);
    const nextDateStr = fmtDate(nextDate);
    stats.intervalDays = interval; stats.easeFactor = ease; stats.nextReviewDate = nextDateStr; stats.lastReviewedDate = todayStr();
    rolloverToday();
    STATE.today.reviewCount = (STATE.today.reviewCount || 0) + 1;
    persist();
    return { interval, ease, nextDateStr };
  }
  return { getDueQuestions, recordReviewRating };
})();

