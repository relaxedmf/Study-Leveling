  }

  function recordAttempt(qId, isCorrect){
    const m = getMastery(qId);
    m.timesAttempted++;
    if(isCorrect){
      m.timesCorrect++;
      m.consecutiveCorrect++;
      m.consecutiveIncorrect = 0;
    } else {
      m.timesIncorrect++;
      m.consecutiveIncorrect++;
      m.consecutiveCorrect = 0;
    }
    m.accuracy = Math.round((m.timesCorrect / m.timesAttempted) * 100);
    m.lastAttempted = new Date().toISOString();

    const wasMastered = m.masteryLevel === 'Mastered';
    if(m.timesAttempted === 0){
      m.masteryLevel = 'New';
    } else if(m.accuracy < THRESHOLDS.learningAccuracy){
      m.masteryLevel = 'Learning';
    } else if(m.accuracy < THRESHOLDS.developingAccuracy || m.timesAttempted < THRESHOLDS.masteredMinAttempts){
      m.masteryLevel = 'Developing';
    } else {
      m.masteryLevel = 'Mastered';
    }
    if(!wasMastered && m.masteryLevel === 'Mastered' && STATE){
      rolloverToday();
      STATE.today.masteredToday = (STATE.today.masteredToday || 0) + 1;
