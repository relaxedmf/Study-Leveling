      const timed = document.getElementById('toggle-quiz-timed').classList.contains('on');

      QuizEngine.createQuiz({
        scopeType,
        scopeValue,
        selectionFilter,
        count,
        mode,
        feedbackTiming,
        shuffleQ,
        shuffleC,
        timed
      });
      QuizEngine.startTimerIfNeeded();
      UI.renderQuizActiveScreen();
    });
  }

  const btnQuizResume = document.getElementById('btn-quiz-resume');
  if(btnQuizResume) btnQuizResume.addEventListener('click', () => { QuizEngine.startTimerIfNeeded(); UI.renderQuizActiveScreen(); });

  const btnQuizDiscard = document.getElementById('btn-quiz-discard');
  if(btnQuizDiscard) btnQuizDiscard.addEventListener('click', () => QuizEngine.discardSession());

  const toggleShuffleQ = document.getElementById('toggle-quiz-shuffle-q');
  if(toggleShuffleQ) toggleShuffleQ.addEventListener('click', () => toggleShuffleQ.classList.toggle('on'));

  const toggleShuffleC = document.getElementById('toggle-quiz-shuffle-c');
  if(toggleShuffleC) toggleShuffleC.addEventListener('click', () => toggleShuffleC.classList.toggle('on'));

  const toggleTimed = document.getElementById('toggle-quiz-timed');
  if(toggleTimed) toggleTimed.addEventListener('click', () => toggleTimed.classList.toggle('on'));

  const optionsContainer = document.getElementById('quiz-options-container');
  if(optionsContainer){
    optionsContainer.addEventListener('click', (e) => {
      const card = e.target.closest('[data-quiz-choice-id]');
      if(card) QuizEngine.submitChoice(card.dataset.quizChoiceId, { x: e.clientX, y: e.clientY });
    });
  }

  const btnQuizPrev = document.getElementById('btn-quiz-prev');
  if(btnQuizPrev) btnQuizPrev.addEventListener('click', () => QuizEngine.prevQuestion());

  const btnQuizNext = document.getElementById('btn-quiz-next');
  if(btnQuizNext) btnQuizNext.addEventListener('click', () => QuizEngine.nextQuestion());

  const btnQuizSkip = document.getElementById('btn-quiz-skip');
  if(btnQuizSkip) btnQuizSkip.addEventListener('click', () => QuizEngine.skipQuestion());

  const btnQuizFinish = document.getElementById('btn-quiz-finish');
  if(btnQuizFinish) btnQuizFinish.addEventListener('click', () => QuizEngine.finishQuiz());

  const btnQuizFlag = document.getElementById('btn-quiz-important');
  if(btnQuizFlag) btnQuizFlag.addEventListener('click', () => QuizEngine.toggleFlag());

  const btnQuizNew = document.getElementById('btn-quiz-new');
  if(btnQuizNew) btnQuizNew.addEventListener('click', () => {
    STATE.activeQuiz = null; persist(); UI.renderQuizSetupScreen();
  });

  const btnQuizRetryIncorrect = document.getElementById('btn-quiz-retry-incorrect');
  if(btnQuizRetryIncorrect) btnQuizRetryIncorrect.addEventListener('click', () => QuizEngine.retryIncorrect());

  const btnQuizReviewAll = document.getElementById('btn-quiz-review-all');
  if(btnQuizReviewAll) btnQuizReviewAll.addEventListener('click', () => {
    const quiz = STATE.activeQuiz;
    if(quiz) UI.renderQuizReviewList(quiz.questions, quiz.answers, 'all');
  });

  const btnQuizReviewIncorrect = document.getElementById('btn-quiz-review-incorrect');
  if(btnQuizReviewIncorrect) btnQuizReviewIncorrect.addEventListener('click', () => {
    const quiz = STATE.activeQuiz;
    if(quiz) UI.renderQuizReviewList(quiz.questions, quiz.answers, 'incorrect');
  });

  const cardReviewQueue = document.getElementById('card-review-queue');
  if(cardReviewQueue){
    cardReviewQueue.addEventListener('click', () => {
      QuizEngine.createQuiz({ mode: 'review', count: 'all', shuffleQ: true });
      UI.switchView('quiz-engine');
      document.querySelectorAll('.nav-item').forEach(el => el.classList.toggle('active', el.dataset.view === 'quiz-engine'));
    });
  }

  const srRatingsBar = document.getElementById('quiz-sr-ratings');
  if(srRatingsBar){
    srRatingsBar.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-sr-rating]');
      if(btn){
        const rating = btn.dataset.srRating;
        const quiz = STATE.activeQuiz;
        if(quiz && quiz.questions[quiz.currentIndex]){
          const currentQ = quiz.questions[quiz.currentIndex];
          const res = ReviewQueue.recordReviewRating(currentQ.id, rating);
          const choiceText = currentQ.correctText || (currentQ.choices[0]?currentQ.choices[0].text:'');
          QuizEngine.submitChoice(choiceText, { x: e.clientX, y: e.clientY });
          Notify.toast('info', 'Review Scheduled', `Next review set in ${res.interval} day(s) (${res.nextDateStr})`);
        }
      }
    });
  }

  // --- Settings Event Listeners ---
  document.querySelectorAll('.theme-swatch').forEach(el => {
    el.addEventListener('click', () => UI.applyTheme(el.dataset.theme));
  });

  const toggleAnim = document.getElementById('toggle-animations');
  if(toggleAnim){
    toggleAnim.addEventListener('click', (e) => {
      STATE.settings.animations = !STATE.settings.animations;
      e.currentTarget.classList.toggle('on', STATE.settings.animations);
      document.documentElement.classList.toggle('no-animations', !STATE.settings.animations);
      persist();
    });
  }

  const toggleSnd = document.getElementById('toggle-sound');
  if(toggleSnd){
    toggleSnd.addEventListener('click', (e) => {
      STATE.settings.sound = !STATE.settings.sound;
      e.currentTarget.classList.toggle('on', STATE.settings.sound);
      persist();
    });
  }

  const btnSaveXp = document.getElementById('btn-save-xp-rates');
  if(btnSaveXp){
    btnSaveXp.addEventListener('click', () => {
      const qVal = parseInt(document.getElementById('xp-rate-question').value, 10);
      const qXp = (!isNaN(qVal) && qVal > 0) ? qVal : 2;
      STATE.settings.xpRates = { question: qXp };
      persist();
      Notify.toast('info', 'XP Rate Saved', `Quiz Engine set to +${qXp} XP per correct question.`);
    });
  }

  const btnExport = document.getElementById('btn-export');
  if(btnExport) btnExport.addEventListener('click', () => DataOps.exportBackup());

  const btnImport = document.getElementById('btn-import');
  const importInput = document.getElementById('import-file-input');
  if(btnImport && importInput){
    btnImport.addEventListener('click', () => importInput.click());
    importInput.addEventListener('change', (e) => {
      if(e.target.files[0]) DataOps.importBackup(e.target.files[0]);
      e.target.value = '';
    });
  }

  const btnPrestige = document.getElementById('btn-prestige-ascend');
  if(btnPrestige){
    btnPrestige.addEventListener('click', () => {
      HunterSystem.prestigeAscend();
    });
  }

  const btnReset = document.getElementById('btn-reset');
  if(btnReset){
    btnReset.addEventListener('click', () => {
      if(confirm('This will permanently erase all XP, question bank mastery, quests, and achievements. Continue?')){
        DataOps.resetAll();
      }
    });
  }

  DriveSync.initUI();
}

function launchApp(){
  document.getElementById('app-shell').classList.remove('hidden');
  document.documentElement.setAttribute('data-theme', STATE.settings.theme || 'solo-blue');
  RenderAll(); UI.switchView('dashboard');
}

async function init(){
  await Storage.init();
  const savedSt = await Storage.get('state');
  if(savedSt){
    STATE = Object.assign(defaultState(), savedSt);
    STATE.settings = Object.assign(
      { theme:'solo-blue', sound:true, animations:true, xpRates: Object.assign({}, DEFAULT_XP_RATES), driveSync: { clientId:'', fileId:null, lastSyncedAt:null, autoSync:false } },
      savedSt.settings||{}
    );
    STATE.settings.driveSync = Object.assign({ clientId:'', fileId:null, lastSyncedAt:null, autoSync:false }, (savedSt.settings||{}).driveSync||{});
  }
  wireEvents();
  launchApp();
  Timer.resumeIfNeeded();
}

document.addEventListener('DOMContentLoaded', init);
})();
</script>
</body>
</html>
