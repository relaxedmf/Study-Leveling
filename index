  if(clearAllBtn) clearAllBtn.addEventListener('click', () => QuestionBankManager.clearAllBanks());

  const qbSubFilter = document.getElementById('qb-preview-filter-subject');
  if(qbSubFilter) qbSubFilter.addEventListener('change', () => UI.renderQuestionBankPreview());

  const qbSearchInput = document.getElementById('qb-preview-search');
  if(qbSearchInput) qbSearchInput.addEventListener('input', debounce(() => UI.renderQuestionBankPreview(), 200));

  // --- Resource Links Events ---
  const btnAddRes = document.getElementById('btn-add-resource');
  if(btnAddRes){
    btnAddRes.addEventListener('click', () => {
      const matInput = document.getElementById('res-input-material');
      const linkInput = document.getElementById('res-input-link');
      if(matInput && linkInput && ResourceOps.addResource(matInput.value, linkInput.value)){
        matInput.value = ''; linkInput.value = '';
      }
    });
  }

  const resGrid = document.getElementById('resources-grid');
  if(resGrid){
    resGrid.addEventListener('click', (e) => {
      const editBtn = e.target.closest('[data-edit-res]');
      if(editBtn){ e.preventDefault(); ResourceOps.editResource(editBtn.dataset.editRes); return; }
      const delBtn = e.target.closest('[data-delete-res]');
      if(delBtn){ e.preventDefault(); ResourceOps.deleteResource(delBtn.dataset.deleteRes); return; }
