  renderQuizActiveScreen(){
    const quiz = STATE.activeQuiz;
    if(!quiz || quiz.isFinished){ UI.renderQuizSetupScreen(); return; }

    const setupPanel = document.getElementById('quiz-setup-panel');
    const activePanel = document.getElementById('quiz-active-panel');
    const resultsPanel = document.getElementById('quiz-results-panel');
    if(setupPanel) setupPanel.classList.add('hidden');
    if(activePanel) activePanel.classList.remove('hidden');
    if(resultsPanel) resultsPanel.classList.add('hidden');

    const total = quiz.questions.length || 1;
    const curIdx = quiz.currentIndex;
    const currentQ = quiz.questions[curIdx];

    document.getElementById('quiz-meta-info').textContent = `QUESTION ${curIdx + 1} / ${total} &middot; ${quiz.title.toUpperCase()}`;
    
    const timerDisplay = document.getElementById('quiz-timer-display');
    if(timerDisplay){
      if(quiz.timed){
        timerDisplay.classList.remove('hidden');
        timerDisplay.textContent = `⏱️ ${pad2(Math.floor(quiz.timeRemaining/60))}:${pad2(quiz.timeRemaining%60)}`;
      } else {
        timerDisplay.classList.add('hidden');
      }
    }

    const flagBtn = document.getElementById('btn-quiz-important');
    if(flagBtn){
      const isFlagged = quiz.flags && quiz.flags[curIdx];
      flagBtn.textContent = isFlagged ? '🚩 Flagged' : '☆ Flag Question';
      flagBtn.classList.toggle('btn-danger', !!isFlagged);
      flagBtn.classList.toggle('btn-ghost', !isFlagged);
    }

    const pct = Math.round(((curIdx + 1) / total) * 100);
    document.getElementById('quiz-progress-bar').style.width = pct + '%';

    const m = MasterySystem.getMastery(currentQ.id);
    const masteryBadge = `<span class="nav-badge" style="background:rgba(41,211,255,0.15); color:var(--accent-blue); font-size:10px; margin-left:8px;">${m.masteryLevel} (${m.accuracy}% Acc)</span>`;
    document.getElementById('quiz-question-path').innerHTML = `${escapeHtml(currentQ.topic)} &middot; Bank: ${escapeHtml(currentQ.bankFileName)}${masteryBadge}`;
    document.getElementById('quiz-question-text').textContent = currentQ.questionText;

    const optionsContainer = document.getElementById('quiz-options-container');
    const explanationBox = document.getElementById('quiz-explanation-box');
    const curAttempts = (quiz.attempts && quiz.attempts[curIdx]) || [];
    const curClicks = (quiz.clicksCount && quiz.clicksCount[curIdx]) || 0;
    const isExamMode = (quiz.mode === 'exam' || quiz.feedbackTiming === 'end');
    const isCorrectFound = curAttempts.some(id => id === currentQ.correctAnswerId);
    const isLocked = isExamMode ? (curClicks >= 1) : (curClicks >= 4 || isCorrectFound);

    optionsContainer.innerHTML = (currentQ.options||[]).map((opt, i) => {
      const isTried = curAttempts.includes(opt.id);
      const isCorrectOpt = (opt.id === currentQ.correctAnswerId);
      const isSelected = quiz.answers && (quiz.answers[curIdx] === opt.id);

      let borderColor = 'var(--panel-border)';
      let bgColor = 'rgba(255,255,255,0.03)';
      let statusBadge = '';
      let badgeBg = 'transparent';
      let badgeColor = 'var(--text-mid)';
      let isOptionDisabled = false;

      if(isExamMode){
        // Exam Mode: NO correct/incorrect feedback, options remain clickable so user can change choice
        isOptionDisabled = false;
        if(isSelected){
          borderColor = 'var(--accent-blue)';
          bgColor = 'rgba(41,211,255,0.14)';
          badgeBg = 'var(--accent-gradient)';
          badgeColor = '#05060d';
          statusBadge = '<span style="margin-left:auto; color:var(--accent-blue); font-weight:700; font-family:var(--font-mono); font-size:12px;">Selected</span>';
        }
      } else {
        // Immediate Feedback Mode
        if(isTried){
          isOptionDisabled = true;
          if(isCorrectOpt){
            borderColor = 'var(--success)';
            bgColor = 'rgba(52,234,185,0.14)';
            statusBadge = '<span style="margin-left:auto; color:var(--success); font-weight:700; font-family:var(--font-mono); font-size:12px;">✓ Correct</span>';
            badgeBg = 'var(--success)';
            badgeColor = '#05060d';
          } else {
            borderColor = 'var(--danger)';
            bgColor = 'rgba(255,77,109,0.12)';
            statusBadge = '<span style="margin-left:auto; color:var(--danger); font-weight:700; font-family:var(--font-mono); font-size:12px;">✗ Incorrect</span>';
            badgeBg = 'rgba(255,77,109,0.2)';
            badgeColor = 'var(--danger)';
          }
        } else if(isLocked){
          isOptionDisabled = true;
          if(isCorrectOpt){
            borderColor = 'var(--gold)';
            bgColor = 'rgba(255,209,102,0.12)';
            statusBadge = '<span style="margin-left:auto; color:var(--gold); font-weight:700; font-family:var(--font-mono); font-size:12px;">Correct Answer</span>';
          }
        }
      }

      const stylePointer = isOptionDisabled ? 'cursor:not-allowed; opacity:' + (isTried || (isLocked && isCorrectOpt) ? '1' : '0.55') + ';' : 'cursor:pointer;';

      return `<div class="panel quiz-opt-card" data-quiz-choice-id="${escapeHtml(opt.id)}" style="padding:14px 18px; ${stylePointer} display:flex; align-items:center; gap:12px; transition:all .15s; border-color:${borderColor}; background:${bgColor};">
        <div style="width:28px; height:28px; border-radius:50%; border:1px solid ${borderColor}; display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:700; color:${badgeColor}; background:${badgeBg};">${String.fromCharCode(65+i)}</div>
        <div style="font-size:14px; color:var(--text-hi); font-weight:500;">${escapeHtml(opt.text)}</div>
        ${statusBadge}
      </div>`;
    }).join('');

    if(explanationBox){
      if(!isExamMode && isLocked && currentQ.explanation){
        explanationBox.classList.remove('hidden');
        explanationBox.innerHTML = `<strong style="color:var(--gold);">Explanation:</strong> ${escapeHtml(currentQ.explanation)}`;
      } else {
        explanationBox.classList.add('hidden');
      }
    }

    const prevBtn = document.getElementById('btn-quiz-prev');
    const nextBtn = document.getElementById('btn-quiz-next');
    const finishBtn = document.getElementById('btn-quiz-finish');

    if(prevBtn) prevBtn.disabled = (curIdx === 0);
    if(curIdx === total - 1){
      if(nextBtn) nextBtn.classList.add('hidden');
      if(finishBtn) finishBtn.classList.remove('hidden');
    } else {
      if(nextBtn) nextBtn.classList.remove('hidden');
      if(finishBtn) finishBtn.classList.add('hidden');
    }
  },

  renderQuizResultsScreen(){
    const quiz = STATE.activeQuiz;
    const setupPanel = document.getElementById('quiz-setup-panel');
    const activePanel = document.getElementById('quiz-active-panel');
    const resultsPanel = document.getElementById('quiz-results-panel');
    if(setupPanel) setupPanel.classList.add('hidden');
    if(activePanel) activePanel.classList.add('hidden');
    if(resultsPanel) resultsPanel.classList.remove('hidden');

    if(quiz){
      document.getElementById('quiz-result-score').textContent = (quiz.scorePct || 0) + '%';
      document.getElementById('quiz-result-sub').textContent = `${quiz.correctCount || 0} Correct · ${quiz.incorrectCount || 0} Incorrect · ${quiz.unansweredCount || 0} Unanswered (of ${quiz.questions.length})`;
      document.getElementById('quiz-result-xp').textContent = `Time Spent: ${fmtSecs(quiz.timeSpentSec||0)} (Avg ${quiz.avgTimePerQ||0}s/Q) · +${quiz.xpEarned||0} XP Earned`;
      UI.renderQuizReviewList(quiz.questions, quiz.answers, 'all');
    }
  },

  renderQuizReviewList(questions, answers, filterMode){
    const listEl = document.getElementById('quiz-review-list');
    if(!listEl) return;

    let items = (questions || []).map((q, idx) => {
      const userChoiceId = answers ? answers[idx] : null;
      const userOpt = (q.options||[]).find(o => o.id === userChoiceId);
      const isCorrect = userChoiceId === q.correctAnswerId;
      return { q, idx, userOpt, isCorrect };
    });

    if(filterMode === 'incorrect'){
      items = items.filter(it => !it.isCorrect);
    }

    if(!items.length){
      listEl.innerHTML = '<div class="empty-state">No questions match the review filter.</div>';
      return;
    }

    listEl.innerHTML = items.map(item => {
      const { q, idx, userOpt, isCorrect } = item;
      const m = MasterySystem.getMastery(q.id);
      return `<div style="padding:14px 16px; border-bottom:1px solid var(--panel-border); font-size:13px; background:rgba(255,255,255,0.01);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
          <span class="eyebrow">#${idx+1} &middot; Topic: ${escapeHtml(q.topic)} &middot; Bank: ${escapeHtml(q.bankFileName)}</span>
          <span style="font-weight:700; color:${isCorrect?'var(--success)':'var(--danger)'};">${isCorrect?'✓ CORRECT':'✗ INCORRECT'} &middot; Level: ${m.masteryLevel} (${m.accuracy}%)</span>
        </div>
        <div style="font-weight:600; color:var(--text-hi); font-size:14px; margin-bottom:8px;">${escapeHtml(q.questionText)}</div>
        <div style="font-size:12px; color:var(--text-mid); line-height:1.6;">
          <div>Your Answer: <strong style="color:${isCorrect?'var(--success)':'var(--danger)'};">${userOpt ? escapeHtml(userOpt.text) : 'Unanswered / Skipped'}</strong></div>
          ${!isCorrect ? `<div>Correct Answer: <strong style="color:var(--success);">${escapeHtml(q.correctText)}</strong></div>` : ''}
          ${q.explanation ? `<div style="margin-top:6px; color:var(--gold); font-style:italic;">Explanation: ${escapeHtml(q.explanation)}</div>` : ''}
        </div>
      </div>`;
    }).join('');
  },

  renderStatistics(){
    rolloverToday();
    const dbData = QuestionBankManager.getMergedDatabase();
    let totalAttempts = 0, totalCorrect = 0, masteredCount = 0, needImproveCount = 0;
    const topicAcc = {}, bankAcc = {};

    dbData.mergedQuestions.forEach(q => {
      const m = MasterySystem.getMastery(q.id);
      totalAttempts += m.timesAttempted;
      totalCorrect += m.timesCorrect;
      if(m.masteryLevel === 'Mastered') masteredCount++;
      if(m.masteryLevel === 'Learning') needImproveCount++;
      if(m.timesAttempted > 0){
        const tKey = q.topic || 'General';
        if(!topicAcc[tKey]) topicAcc[tKey] = { correct:0, attempted:0 };
        topicAcc[tKey].correct += m.timesCorrect; topicAcc[tKey].attempted += m.timesAttempted;

        const bKey = q.bankFileName || 'Question Bank';
        if(!bankAcc[bKey]) bankAcc[bKey] = { correct:0, attempted:0 };
        bankAcc[bKey].correct += m.timesCorrect; bankAcc[bKey].attempted += m.timesAttempted;
      }
    });

    const mEl = document.getElementById('stat-card-mastered'); if(mEl) mEl.textContent = masteredCount;
    const rEl = document.getElementById('stat-card-needing-review'); if(rEl) rEl.textContent = needImproveCount;
    const xEl = document.getElementById('stat-card-xp-total'); if(xEl) xEl.textContent = STATE.xp;
    const sEl = document.getElementById('stat-card-streak'); if(sEl) sEl.textContent = (STATE.streak ? STATE.streak.current : 0) + 'd';

    UI.renderStatCharts(bankAcc, topicAcc);
    UI.renderHeatmap('full-heatmap', 365, 13);
  },

  _chartInstances: {},
  _destroyChart(id){
    if(UI._chartInstances[id]){ UI._chartInstances[id].destroy(); delete UI._chartInstances[id]; }
  },
  renderStatCharts(bankAcc, topicAcc){
    if(typeof Chart === 'undefined') return;
    const styles = getComputedStyle(document.documentElement);
    const cBlue = styles.getPropertyValue('--accent-blue').trim() || '#29d3ff';
    const cPurple = styles.getPropertyValue('--accent-purple').trim() || '#b06bff';
    const cGold = styles.getPropertyValue('--gold').trim() || '#ffd166';
    const cSuccess = styles.getPropertyValue('--success').trim() || '#34eab9';
    const cGrid = 'rgba(255,255,255,0.08)';
    const cText = styles.getPropertyValue('--text-mid').trim() || '#9aa4b8';
    const commonScales = {
      x:{ ticks:{ color:cText, font:{size:10} }, grid:{ color:cGrid } },
      y:{ ticks:{ color:cText, font:{size:10} }, grid:{ color:cGrid }, beginAtZero:true }
    };
    const commonOpts = { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } } };

    // XP Gained Over Time (30d)
    const xpEl = document.getElementById('chart-xp');
    if(xpEl){
      const labels = [], data = [];
      let cursor = new Date();
      for(let i=0;i<30;i++){ const d = fmtDate(cursor); labels.unshift(d.slice(5)); data.unshift((STATE.dailyXP && STATE.dailyXP[d]) || 0); cursor.setDate(cursor.getDate()-1); }
      UI._destroyChart('chart-xp');
      UI._chartInstances['chart-xp'] = new Chart(xpEl, {
        type:'line',
        data:{ labels, datasets:[{ data, borderColor:cBlue, backgroundColor:'rgba(41,211,255,0.15)', fill:true, tension:0.3, pointRadius:0 }] },
        options: Object.assign({}, commonOpts, { scales: commonScales })
      });
    }

    // Accuracy by Subject (bank)
    const subEl = document.getElementById('chart-accuracy-subject');
    if(subEl){
      const entries = Object.entries(bankAcc).map(([k,v]) => ({ k, acc: Math.round((v.correct/v.attempted)*100) })).sort((a,b) => b.acc - a.acc).slice(0, 8);
      UI._destroyChart('chart-accuracy-subject');
      UI._chartInstances['chart-accuracy-subject'] = new Chart(subEl, {
        type:'bar',
        data:{ labels: entries.map(e => e.k), datasets:[{ data: entries.map(e => e.acc), backgroundColor: cPurple, borderRadius:4 }] },
        options: Object.assign({}, commonOpts, { scales: Object.assign({}, commonScales, { y:Object.assign({}, commonScales.y, { max:100 }) }) })
      });
    }

    // Accuracy by Topic (Top Attempted)
    const topEl = document.getElementById('chart-accuracy-topic');
    if(topEl){
      const entries = Object.entries(topicAcc).map(([k,v]) => ({ k, acc: Math.round((v.correct/v.attempted)*100), attempted: v.attempted })).sort((a,b) => b.attempted - a.attempted).slice(0, 8);
      UI._destroyChart('chart-accuracy-topic');
      UI._chartInstances['chart-accuracy-topic'] = new Chart(topEl, {
        type:'bar',
        data:{ labels: entries.map(e => e.k), datasets:[{ data: entries.map(e => e.acc), backgroundColor: cGold, borderRadius:4 }] },
        options: Object.assign({}, commonOpts, { scales: Object.assign({}, commonScales, { y:Object.assign({}, commonScales.y, { max:100 }) }) })
      });
    }

    // Study Streak Activity (14d) — actions logged per day
    const streakEl = document.getElementById('chart-study-streak');
    if(streakEl){
      const labels = [], data = [];
      let cursor = new Date();
      for(let i=0;i<14;i++){ const d = fmtDate(cursor); labels.unshift(d.slice(5)); data.unshift((STATE.activityLog && STATE.activityLog[d]) || 0); cursor.setDate(cursor.getDate()-1); }
      UI._destroyChart('chart-study-streak');
      UI._chartInstances['chart-study-streak'] = new Chart(streakEl, {
        type:'bar',
        data:{ labels, datasets:[{ data, backgroundColor: cSuccess, borderRadius:4 }] },
        options: Object.assign({}, commonOpts, { scales: commonScales })
      });
    }

    // Practice Questions (30d)
    const qEl = document.getElementById('chart-questions');
    if(qEl){
      const labels = [], data = [];
      let cursor = new Date();
      for(let i=0;i<30;i++){ const d = fmtDate(cursor); labels.unshift(d.slice(5)); data.unshift((STATE.dailyQuestionsLog && STATE.dailyQuestionsLog[d]) || 0); cursor.setDate(cursor.getDate()-1); }
      UI._destroyChart('chart-questions');
      UI._chartInstances['chart-questions'] = new Chart(qEl, {
        type:'line',
        data:{ labels, datasets:[{ data, borderColor:cGold, backgroundColor:'rgba(255,209,102,0.15)', fill:true, tension:0.3, pointRadius:0 }] },
        options: Object.assign({}, commonOpts, { scales: commonScales })
      });
    }
  },

  renderSettings(){
    document.querySelectorAll('.theme-swatch').forEach(el => el.classList.toggle('active', el.dataset.theme === STATE.settings.theme));
    const toggleAnim = document.getElementById('toggle-animations');
    if(toggleAnim) toggleAnim.classList.toggle('on', STATE.settings.animations);
    const toggleSnd = document.getElementById('toggle-sound');
    if(toggleSnd) toggleSnd.classList.toggle('on', STATE.settings.sound);

    if(STATE.settings.xpRates){
      const q = document.getElementById('xp-rate-question'); if(q) q.value = STATE.settings.xpRates.question || 2;
    }
